export struct TreeRow {
    path: string,
    name: string,
    depth: int,
    is-dir: bool,
    is-expanded: bool,
    is-selected: bool,
    is-cut: bool,
    kind: string,
}

export struct BreadcrumbRow {
    name: string,
    path: string,
}

export struct CommentRow {
    start: float,
    end: float,
    bubble-end: float,
    text: string,
    label-id: int,
    label-color: color,
    label-known: bool,
}

export struct TagRow {
    id: int,
    name: string,
}

export struct TrackDifference {
    label: string,
    value: string,
}

export struct AudioRow {
    path: string,
    name: string,
    subtitle: string,
    is-folder: bool,
    depth: int,
    is-expanded: bool,
    modified-date: string,
    waveform: image,
    is-loading: bool,
    comments: [CommentRow],
    differences: [TrackDifference],
    similarity: float,
    rating: int,
    is-pinned: bool,
    is-selected: bool,
    is-primary: bool,
    is-active: bool,
    is-playing: bool,
    progress: float,
    duration-seconds: float,
    is-cut: bool,
    loop-enabled: bool,
    selected-comment-start: float,
    selected-comment-end: float,
    label-id: int,
    label-name: string,
    label-color: color,
    label-known: bool,
    tags: [TagRow],
    available-tags: [TagRow],
}

export struct WorkflowLoraRow {
    node-id: string,
    filename: string,
    strength: string,
    custom-tag: string,
}

export struct WorkflowFileRow {
    name: string,
    path: string,
}

export struct ConversionRow {
    name: string,
    path: string,
    progress: float,
    status: string,
}
