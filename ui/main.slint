import { Button, ComboBox, LineEdit, ListView, ScrollView, Slider, TextEdit, VerticalBox } from "std-widgets.slint";

export struct TreeRow {
    path: string,
    name: string,
    depth: int,
    is-dir: bool,
    is-expanded: bool,
    is-selected: bool,
    kind: string,
}

export struct CommentRow {
    start: float,
    end: float,
    bubble-end: float,
    text: string,
}

export struct AudioRow {
    path: string,
    name: string,
    modified-date: string,
    peaks: [float],
    comments: [CommentRow],
    rating: int,
    is-active: bool,
    is-playing: bool,
    progress: float,
    loop-enabled: bool,
    selected-comment-start: float,
    selected-comment-end: float,
}

export struct WorkflowLoraRow {
    filename: string,
    strength: string,
    custom-tag: string,
}

export struct WorkflowFileRow {
    name: string,
    path: string,
}

component WorkflowSuggestionBox inherits Rectangle {
    in property <[WorkflowFileRow]> files: [];
    in-out property <string> query: "";
    in property <bool> light-theme: false;
    in-out property <bool> list-visible: false;
    callback selected(string);
    callback search-requested(string);
    height: 28px;
    background: transparent;

    LineEdit {
        width: 100%;
        placeholder-text: "Search workflows...";
        text <=> root.query;
        changed has-focus => {
            if self.has-focus {
                root.list-visible = true;
            } else {
                root.list-visible = false;
            }
        }
        edited(text) => {
            root.list-visible = true;
            root.search-requested(text);
        }
    }
    if root.list-visible : Rectangle {
        y: 30px;
        width: root.width;
        height: 150px;
        z: 20;
        background: root.light-theme ? #ffffff : #202832;
        border-color: root.light-theme ? #cbd2dc : #435064;
        border-width: 1px;
        ListView {
            width: 100%;
            height: 100%;
            for file in root.files : Rectangle {
                height: 26px;
                background: file-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text { text: file.name; x: 8px; width: parent.width - 16px; color: root.light-theme ? #202833 : #f1f4f8; vertical-alignment: center; overflow: elide; }
                file-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.query = file.name;
                        root.list-visible = false;
                        root.selected(file.path);
                    }
                }
            }
        }
    }
}

component Waveform inherits Rectangle {
    height: 58px;
    background: transparent;
    in property <bool> light-theme;
    in property <color> comment-background-color: #000000;
    in property <color> comment-text-color: #ffffff;
    in property <bool> is-active;
    in property <[float]> peaks;
    in property <[CommentRow]> comments: [];
    in property <float> selected-comment-start: -1;
    in property <float> selected-comment-end: -1;
    property <int> hovered-comment: -1;
    property <float> gesture-start: -1;
    property <float> gesture-end: -1;
    property <float> comment-drag-start: -1;
    property <float> comment-drag-original-start: -1;
    property <float> comment-drag-original-end: -1;
    property <int> comment-drag-index: -1;
    property <float> comment-drag-preview-start: -1;
    property <bool> comment-dragged: false;
    in property <float> progress: 0;
    callback seek-requested(float);
    callback comment-range-requested(float, float);
    callback comment-selected(float, float, string);
    callback comment-edit-requested(float, float, string);
    callback comment-range-moved(float, float, float, float, string);

    function displayed-comment-start(index: int, start: float) -> float {
        return index == root.comment-drag-index ? root.comment-drag-preview-start : start;
    }

    VerticalBox {
        spacing: 0px;
        Rectangle {
            height: 29px;
            HorizontalLayout {
                spacing: 2px;
                for peak[index] in root.peaks : Rectangle {
                    width: (parent.width - (root.peaks.length - 1) * 2px) / root.peaks.length;
                    height: 29px;
                    Rectangle {
                        width: 100%;
                        height: 2px + peak * 25px;
                        border-radius: 1px;
                        y: parent.height - self.height;
                        background: (index / root.peaks.length) <= root.progress ? (root.light-theme ? #d46b32 : #e58a4d) : (root.light-theme ? #b8c0ca : #566171);
                    }
                }
            }
        }
        Rectangle {
            height: 29px;
            HorizontalLayout {
                spacing: 2px;
                for peak[index] in root.peaks : Rectangle {
                    width: (parent.width - (root.peaks.length - 1) * 2px) / root.peaks.length;
                    height: 29px;
                    Rectangle {
                        width: 100%;
                        height: 2px + peak * 25px;
                        border-radius: 1px;
                        y: 0px;
                        opacity: 0.5;
                        background: (index / root.peaks.length) <= root.progress ? (root.light-theme ? #d46b32 : #e58a4d) : (root.light-theme ? #b8c0ca : #566171);
                    }
                }
            }
        }
    }
    Rectangle {
        x: root.progress * (parent.width - 1px);
        y: 0px;
        width: 1px;
        height: parent.height;
        background: #ffffff;
        visible: root.is-active && root.peaks.length > 0;
    }
    if root.selected-comment-start >= 0 && root.selected-comment-end >= root.selected-comment-start : Rectangle {
        x: root.selected-comment-start * parent.width;
        width: (root.selected-comment-end - root.selected-comment-start) * parent.width;
        y: 0px;
        height: parent.height;
        background: root.light-theme ? #d46b3240 : #e58a4d40;
        border-color: root.light-theme ? #d46b32 : #e58a4d;
        border-width: 1px;
    }
    if root.selected-comment-start >= 0 : Rectangle {
        x: root.selected-comment-start * parent.width;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: #11151b;
        Text { text: "▼"; x: -5px; y: -2px; color: #11151b; font-size: 10px; }
    }
    if root.selected-comment-end > root.selected-comment-start : Rectangle {
        x: root.selected-comment-end * parent.width;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: #11151b;
        Text { text: "▼"; x: -5px; y: -2px; color: #11151b; font-size: 10px; }
    }
    if root.hovered-comment >= 0 && root.comments[root.hovered-comment].end >= root.comments[root.hovered-comment].start : Rectangle {
        x: root.comments[root.hovered-comment].start * parent.width;
        width: (root.comments[root.hovered-comment].end - root.comments[root.hovered-comment].start) * parent.width;
        y: 0px;
        height: parent.height;
        background: root.light-theme ? #d46b3260 : #e58a4d60;
        border-color: root.light-theme ? #d46b32 : #e58a4d;
        border-width: 1px;
    }
    if root.hovered-comment >= 0 : Rectangle {
        x: root.comments[root.hovered-comment].start * parent.width;
        y: 0px;
        width: 2px;
        height: parent.height;
        background: #11151b;
        Text { text: "▼"; x: -5px; y: 0px; color: #11151b; font-size: 10px; }
    }
    if root.hovered-comment >= 0 && root.comments[root.hovered-comment].end > root.comments[root.hovered-comment].start : Rectangle {
        x: root.comments[root.hovered-comment].end * parent.width;
        y: 0px;
        width: 2px;
        height: parent.height;
        background: #11151b;
        Text { text: "▼"; x: -5px; y: 0px; color: #11151b; font-size: 10px; }
    }
    if root.gesture-start >= 0 && root.gesture-end >= root.gesture-start : Rectangle {
        x: root.gesture-start * parent.width;
        width: (root.gesture-end - root.gesture-start) * parent.width;
        y: 0px;
        height: parent.height;
        background: root.light-theme ? #d46b3260 : #e58a4d60;
        border-color: root.light-theme ? #d46b32 : #e58a4d;
        border-width: 1px;
    }
    if root.gesture-start >= 0 : Rectangle {
        x: root.gesture-start * parent.width;
        y: 0px;
        width: 2px;
        height: parent.height;
        background: #11151b;
        Text { text: "▼"; x: -5px; y: 0px; color: #11151b; font-size: 10px; }
    }
    if root.gesture-end > root.gesture-start : Rectangle {
        x: root.gesture-end * parent.width;
        y: 0px;
        width: 2px;
        height: parent.height;
        background: #11151b;
        Text { text: "▼"; x: -5px; y: 0px; color: #11151b; font-size: 10px; }
    }
    TouchArea {
        clicked => { root.seek-requested((self.mouse-x / self.width).max(0).min(1)); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.gesture-start = (self.mouse-x / self.width).max(0).min(1);
                root.gesture-end = root.gesture-start;
            } else if event.kind == PointerEventKind.move && root.gesture-start >= 0 {
                root.gesture-end = (self.mouse-x / self.width).max(0).min(1);
            } else if event.kind == PointerEventKind.up && root.gesture-start >= 0 {
                root.comment-range-requested(
                    root.gesture-start.min(root.gesture-end),
                    root.gesture-start.max(root.gesture-end)
                );
                root.gesture-start = -1;
                root.gesture-end = -1;
            }
        }
    }
    for comment[index] in root.comments : comment-container := Rectangle {
        x: root.displayed-comment-start(index, comment.start) * parent.width;
        height: parent.height;
        width: ((comment.bubble-end - comment.start) * parent.width).max(comment-text.preferred-width + 8px).min(root.width * (1 - comment.start));
        background: transparent;
        Rectangle {
            x: 1px;
            y: 39px;
            width: comment-touch.has-hover ? (comment-text.preferred-width + 8px).min(root.width * (1 - comment.start) - 2px).max(parent.width - 2px).max(8px) : (comment-text.preferred-width + 8px).min(parent.width - 2px).max(8px);
            height: 17px;
            visible: !comment-touch.has-hover;
            background: root.comment-background-color;
            border-color: root.comment-text-color;
            border-width: 1px;
            comment-text := Text {
                text: comment.text;
                x: 4px;
                width: parent.width - 8px;
                color: root.comment-text-color;
                font-size: 10px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        comment-hit := Rectangle {
            x: 1px;
            y: 39px;
            width: comment-touch.has-hover ? (comment-text.preferred-width + 8px).min(root.width * (1 - comment.start) - 2px).max(8px) : (comment-text.preferred-width + 8px).min(parent.width - 2px).max(8px);
            height: 17px;
            background: transparent;
            comment-touch := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.comment-edit-requested(comment.start, comment.end, comment.text);
                    } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.comment-drag-start = ((self.mouse-x + comment-hit.x + comment-container.x) / root.width).max(0).min(1);
                        root.comment-drag-original-start = comment.start;
                        root.comment-drag-original-end = comment.end;
                        root.comment-drag-index = index;
                        root.comment-drag-preview-start = comment.start;
                        root.comment-dragged = false;
                    } else if event.kind == PointerEventKind.move && root.comment-drag-start >= 0 {
                        let pointer = ((self.mouse-x + comment-hit.x + comment-container.x) / root.width).max(0).min(1);
                        let delta = pointer - root.comment-drag-start;
                        let length = root.comment-drag-original-end - root.comment-drag-original-start;
                        root.comment-drag-preview-start = (root.comment-drag-original-start + delta).max(0).min(1 - length);
                        root.comment-dragged = root.comment-dragged || delta.abs() > 0.005;
                    } else if event.kind == PointerEventKind.up && root.comment-drag-start >= 0 {
                        let pointer = ((self.mouse-x + comment-hit.x + comment-container.x) / root.width).max(0).min(1);
                        let delta = pointer - root.comment-drag-start;
                        if root.comment-dragged {
                            let length = root.comment-drag-original-end - root.comment-drag-original-start;
                            let start = (root.comment-drag-original-start + delta).max(0).min(1 - length);
                            root.comment-range-moved(root.comment-drag-original-start, root.comment-drag-original-end, start, start + length, comment.text);
                        } else {
                            root.comment-selected(comment.start, comment.end, comment.text);
                        }
                        root.comment-drag-start = -1;
                        root.comment-drag-index = -1;
                        root.comment-drag-preview-start = -1;
                        root.comment-dragged = false;
                    }
                }
                changed has-hover => {
                    if self.has-hover {
                        root.hovered-comment = index;
                    } else if root.hovered-comment == index {
                        root.hovered-comment = -1;
                    }
                }
            }
        }
    }
    if root.hovered-comment >= 0 : Rectangle {
        x: root.displayed-comment-start(root.hovered-comment, root.comments[root.hovered-comment].start) * parent.width;
        y: 39px;
        width: (hovered-label.preferred-width + 8px).min(parent.width - self.x - 2px).max(8px);
        height: 17px;
        z: 10;
        background: root.comment-background-color;
        border-color: root.comment-text-color;
        border-width: 1px;
        hovered-label := Text {
            text: root.comments[root.hovered-comment].text;
            x: 4px;
            width: parent.width - 8px;
            color: root.comment-text-color;
            font-size: 10px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

component AudioRowView inherits Rectangle {
    height: 86px;
    background: root.light-theme ? #ffffff : #1a2029;
    border-color: root.is-active ? #000000 : (root.light-theme ? #d9dee6 : #2a3340);
    border-width: 1px;
    in property <bool> light-theme;
    in property <color> comment-background-color: #000000;
    in property <color> comment-text-color: #ffffff;
    in property <string> name;
    in property <string> modified-date;
    in property <[float]> peaks;
    in property <[CommentRow]> comments;
    in property <int> rating: 0;
    property <int> hovered-rating: -1;
    in property <bool> is-active;
    in property <bool> is-playing;
    in property <float> progress;
    in property <bool> loop-enabled;
    in property <float> selected-comment-start: -1;
    in property <float> selected-comment-end: -1;
    callback play-requested();
    callback seek-requested(float);
    callback comment-range-requested(float, float);
    callback comment-selected(float, float, string);
    callback comment-edit-requested(float, float, string);
    callback comment-range-moved(float, float, float, float, string);
    callback rating-requested(int);

    VerticalBox {
        padding: 8px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 2px;
        HorizontalLayout {
            height: 40px;
            spacing: 8px;
            Text {
                text: root.name;
                color: root.light-theme ? #202833 : #e3e8ef;
                font-size: 14px;
                overflow: elide;
                horizontal-stretch: 1;
            }
            HorizontalLayout {
                width: 156px;
                y: 20px;
                spacing: 0px;
                alignment: center;
                for star-index in 5 : Rectangle {
                    width: 24px;
                    height: 32px;
                    Text {
                        text: star-index < (root.hovered-rating >= 0 ? root.hovered-rating : root.rating) ? "★" : "☆";
                        color: star-index < (root.hovered-rating >= 0 ? root.hovered-rating : root.rating) ? #e58a4d : (root.light-theme ? #8b96a7 : #566171);
                        font-size: 24px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.rating-requested(star-index + 1); }
                        changed has-hover => { root.hovered-rating = self.has-hover ? star-index + 1 : -1; }
                    }
                }
                Rectangle {
                    width: 24px;
                    height: 32px;
                    Text { text: "x"; color: root.light-theme ? #8b96a7 : #566171; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        clicked => { root.rating-requested(0); }
                        changed has-hover => { root.hovered-rating = self.has-hover ? 0 : -1; }
                    }
                }
            }
            Rectangle {
                width: 40px;
                height: 40px;
                VerticalBox {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: #ffffff;
                        border-color: root.light-theme ? (play-area.has-hover ? #b8c0ca : #b8c0ca80) : (play-area.has-hover ? #566171 : #56617180);
                        border-width: 2px;
                        Text {
                            text: root.is-playing ? "||" : "▶";
                            color: root.light-theme ? #b8c0ca : #566171;
                            opacity: play-area.has-hover ? 1 : 0.5;
                            font-size: root.is-playing ? 14px : 17px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        play-area := TouchArea {
                            clicked => { root.play-requested(); }
                        }
                    }
                    Rectangle { width: 25px; }
                }
            }
        }
        HorizontalLayout {
            height: 58px;
            Waveform {
                width: parent.width - 204px;
                light-theme: root.light-theme;
                comment-background-color: root.comment-background-color;
                comment-text-color: root.comment-text-color;
                is-active: root.is-active;
                peaks: root.peaks;
                comments: root.comments;
                selected-comment-start: root.selected-comment-start;
                selected-comment-end: root.selected-comment-end;
                progress: root.progress;
                y: -40px;
                seek-requested(progress) => { root.seek-requested(progress); }
                comment-range-requested(start, end) => { root.comment-range-requested(start, end); }
                comment-selected(start, end, text) => { root.comment-selected(start, end, text); }
                comment-edit-requested(start, end, text) => { root.comment-edit-requested(start, end, text); }
                comment-range-moved(old-start, old-end, start, end, text) => { root.comment-range-moved(old-start, old-end, start, end, text); }
            }
            Rectangle { width: 204px; }
        }
    }
}

component AudioList inherits ListView {
    in property <bool> light-theme;
    in property <color> comment-background-color: #000000;
    in property <color> comment-text-color: #ffffff;
    in property <[AudioRow]> rows;
    in property <int> scroll-to-index: -1;
    callback viewport-changed(int);
    callback seek-requested(string, float);
    callback play-requested(string);
    callback comment-range-requested(string, float, float);
    callback comment-selected(string, float, float, string);
    callback comment-edit-requested(string, float, float, string);
    callback comment-range-moved(string, float, float, float, float, string);
    callback rating-requested(string, int);

    changed viewport-y => {
        root.viewport-changed((0px - root.viewport-y) / 86px);
    }

    changed scroll-to-index => {
        if root.scroll-to-index >= 0 {
            root.viewport-y = 0px - root.scroll-to-index * 86px;
        }
    }

    for row in root.rows : AudioRowView {
        light-theme: root.light-theme;
        comment-background-color: root.comment-background-color;
        comment-text-color: root.comment-text-color;
        name: row.name;
        modified-date: row.modified-date;
        peaks: row.peaks;
        comments: row.comments;
        rating: row.rating;
        is-active: row.is-active;
        is-playing: row.is-playing;
        progress: row.progress;
        loop-enabled: row.loop-enabled;
        selected-comment-start: row.selected-comment-start;
        selected-comment-end: row.selected-comment-end;
        seek-requested(progress) => { root.seek-requested(row.path, progress); }
        play-requested => { root.play-requested(row.path); }
        comment-range-requested(start, end) => { root.comment-range-requested(row.path, start, end); }
        comment-selected(start, end, text) => { root.comment-selected(row.path, start, end, text); }
        comment-edit-requested(start, end, text) => { root.comment-edit-requested(row.path, start, end, text); }
        comment-range-moved(old-start, old-end, start, end, text) => { root.comment-range-moved(row.path, old-start, old-end, start, end, text); }
        rating-requested(rating) => { root.rating-requested(row.path, rating); }
    }
}

component ExplorerRow inherits Rectangle {
    height: 26px;
    background: root.is-selected ? (root.light-theme ? #d7e3f3 : #2a3546) : transparent;
    callback clicked();
    callback right-clicked();
    callback edit-accepted(string);
    callback edit-cancelled();
    in property <bool> light-theme;
    in property <string> path;
    in property <string> name;
    in property <int> depth;
    in property <bool> is-dir;
    in property <bool> is-expanded;
    in property <bool> is-selected;
    in property <string> kind;
    in property <bool> editing;
    in-out property <string> edit-text: "";

    function icon-source() -> image {
        if root.kind == "dir" && root.is-expanded {
            return @image-url("../assets/icons/folder-open.svg");
        }
        if root.kind == "dir" {
            return @image-url("../assets/icons/folder.svg");
        }
        if root.kind == "audio" {
            return @image-url("../assets/icons/audio.svg");
        }
        if root.kind == "safetensors" {
            return @image-url("../assets/icons/safetensors.svg");
        }
        if root.kind == "json" {
            return @image-url("../assets/icons/json.svg");
        }
        return @image-url("../assets/icons/file.svg");
    }

    HorizontalLayout {
        padding-left: 8px + root.depth * 16px;
        padding-right: 8px;
        spacing: 6px;
        Image {
            source: root.icon-source();
            width: 16px;
            height: 16px;
            vertical-alignment: center;
        }
        if root.editing : LineEdit {
            text <=> root.edit-text;
            horizontal-stretch: 1;
            changed has-focus => {
                if !self.has-focus {
                    root.edit-cancelled();
                }
            }
            accepted(text) => { root.edit-accepted(text); }
        }
        if !root.editing : Text {
            text: root.name;
            color: root.light-theme ? #202833 : #e3e8ef;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if !root.editing : TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.right-clicked();
            }
        }
    }
}

component MenuButton inherits Rectangle {
    width: 70px;
    height: 40px;
    background: root.light-theme ? #eef1f5 : #1a2029;
    callback clicked();
    in property <bool> light-theme;
    in property <string> label;
    Text {
        text: root.label;
        color: root.light-theme ? #202833 : #d7dce5;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component ToolButton inherits Rectangle {
    width: 48px;
    height: 48px;
    background: root.light-theme ? #e7ebf0 : #171c24;
    callback clicked();
    in property <bool> light-theme;
    in property <string> label;
    Text {
        text: root.label;
        color: root.light-theme ? #455160 : #b7c0ce;
        font-size: 22px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Adb Studio";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 560px;
    background: #11151b;

    in-out property <bool> light-theme: false;
    in-out property <color> comment-background-color: #000000;
    in-out property <color> comment-text-color: #ffffff;
    in-out property <string> comment-background-hex: "#000000";
    in-out property <string> comment-text-hex: "#ffffff";
    in-out property <int> theme-index: 0;
    in-out property <bool> color-picker-visible: false;
    in-out property <int> color-picker-target: 0;
    in-out property <string> color-picker-value: "#000000";
    in-out property <bool> has-folder: false;
    in-out property <string> folder-name: "";
    in-out property <string> build-number: "development";
    in-out property <bool> about-visible: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> file-menu-visible: false;
    in-out property <bool> edit-menu-visible: false;
    in-out property <bool> help-menu-visible: false;
    in-out property <bool> tree-menu-visible: false;
    in-out property <string> tree-menu-path: "";
    in-out property <string> tree-edit-path: "";
    in-out property <string> tree-edit-text: "";
    in-out property <int> tree-edit-mode: 0;
    in-out property <bool> left-pane-visible: true;
    in-out property <length> left-pane-width: 280px;
    callback left-pane-width-changed(length);
    in-out property <[TreeRow]> tree-rows: [];
    in-out property <[AudioRow]> audio-rows: [];
    in-out property <int> audio-scroll-to-index: -1;
    in-out property <string> audio-filter: "";
    in-out property <string> selected-name: "";
    in-out property <bool> audio-loading: false;
    in-out property <int> audio-completed: 0;
    in-out property <int> audio-total: 0;
    in-out property <string> audio-spinner: "|";
    in-out property <string> active-audio-path: "";
    in-out property <string> audio-file-name: "";
    in-out property <bool> audio-playing: false;
    in-out property <bool> loop-enabled: false;
    in-out property <float> audio-volume: 1.0;
    in-out property <string> audio-current-time: "00:00";
    in-out property <string> audio-total-duration: "00:00";
    in-out property <string> audio-error: "";
    in-out property <bool> metadata-visible: false;
    in-out property <length> metadata-pane-height: 190px;
    property <length> metadata-drag-start-y: 0px;
    property <length> metadata-drag-start-height: 190px;
    in-out property <[WorkflowFileRow]> workflow-json-files: [];
    in-out property <string> selected-workflow: "";
    in-out property <bool> workflow-dropdown-visible: false;
    in-out property <string> workflow-bpm: "";
    in-out property <string> workflow-key: "";
    in-out property <string> workflow-seed: "";
    in-out property <string> workflow-prompt: "";
    in-out property <string> workflow-lyrics: "";
    in-out property <[WorkflowLoraRow]> workflow-loras: [];
    in-out property <bool> lora-editor-visible: false;
    in-out property <string> lora-editor-filename: "";
    in-out property <string> lora-editor-tag: "";
    callback open-folder();
    callback close-about();
    callback close-settings();
    callback theme-selected(bool);
    callback comment-colors-selected(string, string);
    callback row-clicked(string);
    callback tree-context-menu(string);
    callback rename-requested();
    callback new-folder-requested(string);
    callback tree-edit-accepted(string, string, int);
    callback tree-edit-cancelled();
    callback filter-changed(string);
    callback audio-viewport-changed(int);
    callback audio-play-pause();
    callback audio-seek(string, float);
    callback audio-play(string);
    callback loop-changed(bool);
    callback volume-changed(float);
    callback comment-range-requested(string, float, float);
    callback comment-selected(string, float, float, string);
    callback comment-edit-requested(string, float, float, string);
    callback comment-range-moved(string, float, float, float, float, string);
    callback rating-requested(string, int);
    callback comment-save(string, string, string, string);
    callback comment-cancel();
    callback comment-delete(string, string, string, string);
    callback metadata-toggle();
    callback metadata-pane-height-changed(length);
    callback workflow-selected(string);
    callback workflow-search-changed(string);
    callback lora-edit-requested(string, string);
    callback lora-save(string, string);
    callback lora-cancel();
    in-out property <bool> comment-editor-visible: false;
    in-out property <string> comment-editor-path: "";
    in-out property <string> comment-editor-start: "0";
    in-out property <string> comment-editor-end: "0";
    in-out property <string> comment-editor-text: "";

    changed left-pane-width => {
        root.left-pane-width-changed(root.left-pane-width);
    }

    changed metadata-pane-height => {
        root.metadata-pane-height-changed(root.metadata-pane-height);
    }

    Rectangle {
        background: root.light-theme ? #f5f7fa : #11151b;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.workflow-dropdown-visible = false;
                root.tree-menu-visible = false;
                if root.tree-edit-path != "" {
                    root.tree-edit-cancelled();
                }
            }
        }

        VerticalBox {
            spacing: 0px;

            Rectangle {
                height: 40px;
                background: root.light-theme ? #eef1f5 : #1a2029;
                border-color: root.light-theme ? #cbd2dc : #2a3340;
                border-width: 1px;

                HorizontalLayout {
                    spacing: 0px;
                    MenuButton {
                        label: "File";
                        light-theme: root.light-theme;
                        clicked => {
                            root.file-menu-visible = !root.file-menu-visible;
                            root.edit-menu-visible = false;
                            root.help-menu-visible = false;
                        }
                    }
                    MenuButton {
                        label: "Edit";
                        light-theme: root.light-theme;
                        clicked => {
                            root.edit-menu-visible = !root.edit-menu-visible;
                            root.file-menu-visible = false;
                            root.help-menu-visible = false;
                        }
                    }
                    MenuButton {
                        label: "Help";
                        light-theme: root.light-theme;
                        clicked => {
                            root.help-menu-visible = !root.help-menu-visible;
                            root.file-menu-visible = false;
                            root.edit-menu-visible = false;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 110px;
                        Text {
                            text: "Adb Studio";
                            width: parent.width - 14px;
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            font-size: 13px;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                Rectangle {
                    width: 48px;
                    background: root.light-theme ? #e7ebf0 : #171c24;
                    border-color: root.light-theme ? #cbd2dc : #2a3340;
                    border-width: 1px;

                    VerticalBox {
                        alignment: start;
                        ToolButton {
                            label: "▤";
                            light-theme: root.light-theme;
                            clicked => { root.left-pane-visible = !root.left-pane-visible; }
                        }
                    }
                }

                if root.left-pane-visible : Rectangle {
                    width: root.left-pane-width;
                    background: root.light-theme ? #eef1f5 : #1a2029;
                    border-color: root.light-theme ? #cbd2dc : #2a3340;
                    border-width: 1px;

                    if root.has-folder : VerticalBox {
                        padding: 18px;
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        Text {
                            text: "EXPLORER";
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            font-size: 11px;
                            x: 12px;
                        }
                        Text {
                            text: root.folder-name;
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 15px;
                            overflow: elide;
                            x: 12px;
                        }
                        Rectangle {
                            height: 1px;
                            background: root.light-theme ? #cbd2dc : #2a3340;
                        }
                        tree-focus := FocusScope {
                            vertical-stretch: 1;
                            key-pressed(event) => {
                                if event.text == Key.F2 {
                                    root.rename-requested();
                                    accept;
                                }
                                reject;
                            }
                            ListView {
                                width: 100%;
                                height: 100%;
                            for row in root.tree-rows : ExplorerRow {
                                light-theme: root.light-theme;
                                path: row.path;
                                name: row.name;
                                depth: row.depth;
                                is-dir: row.is-dir;
                                is-expanded: row.is-expanded;
                                is-selected: row.is-selected;
                                kind: row.kind;
                                editing: root.tree-edit-path == row.path;
                                edit-text <=> root.tree-edit-text;
                                clicked => {
                                    if root.tree-edit-path != "" && root.tree-edit-path != row.path {
                                        root.tree-edit-cancelled();
                                    } else {
                                        tree-focus.focus();
                                        root.row-clicked(row.path);
                                    }
                                }
                                right-clicked => {
                                    if root.tree-edit-path != "" && root.tree-edit-path != row.path {
                                        root.tree-edit-cancelled();
                                    }
                                    tree-focus.focus();
                                    root.tree-menu-path = row.path;
                                    root.tree-menu-visible = true;
                                }
                                edit-accepted(text) => { root.tree-edit-accepted(row.path, text, root.tree-edit-mode); }
                                edit-cancelled => { root.tree-edit-cancelled(); }
                            }
                            }
                        }
                    }

                    if !root.has-folder : VerticalBox {
                        padding: 18px;
                        spacing: 12px;
                        Text {
                            text: "EXPLORER";
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            font-size: 11px;
                        }
                        Text {
                            text: "No folder open";
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 15px;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                if root.left-pane-visible : Rectangle {
                    width: 6px;
                    background: drag-area.has-hover ? (root.light-theme ? #aeb8c6 : #566171) : (root.light-theme ? #e0e5eb : #3b4655);

                    VerticalBox {
                        alignment: center;
                        spacing: 2px;
                        Rectangle {
                            width: 3px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: drag-area.has-hover ? (root.light-theme ? #f5f7fa : #d7dce5) : (root.light-theme ? #8b96a7 : #8b96a7);
                        }
                        Rectangle {
                            width: 3px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: drag-area.has-hover ? (root.light-theme ? #f5f7fa : #d7dce5) : (root.light-theme ? #8b96a7 : #8b96a7);
                        }
                        Rectangle {
                            width: 3px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: drag-area.has-hover ? (root.light-theme ? #f5f7fa : #d7dce5) : (root.light-theme ? #8b96a7 : #8b96a7);
                        }
                    }

                    drag-area := TouchArea {
                        mouse-cursor: ew-resize;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.move && self.pressed {
                                root.left-pane-width = (parent.x + self.mouse-x - 48px).max(180px).min(600px);
                            }
                        }
                    }
                }

                Rectangle {
                    background: root.light-theme ? #f5f7fa : #11151b;
                    horizontal-stretch: 1;

                    if !root.has-folder : VerticalBox {
                        alignment: center;
                        spacing: 14px;
                        Text {
                            text: "Welcome to Adb Studio";
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 28px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Open a workspace folder to begin organizing your audio.";
                            color: root.light-theme ? #5c6878 : #8b96a7;
                            horizontal-alignment: center;
                        }
                        Button {
                            text: "Open Folder...";
                            clicked => { root.open-folder(); }
                        }
                    }

                    if root.has-folder : VerticalBox {
                        padding: 24px;
                        spacing: 18px;
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Audio Library";
                                color: root.light-theme ? #202833 : #e3e8ef;
                                font-size: 24px;
                                vertical-alignment: center;
                            }
                            Button {
                                text: root.metadata-visible ? "Hide Metadata" : "Show Metadata";
                                clicked => { root.metadata-toggle(); }
                            }
                            Button {
                                text: root.audio-playing ? "Pause" : "Play";
                                enabled: root.active-audio-path != "" && root.audio-error == "";
                                clicked => { root.audio-play-pause(); }
                            }
                            Button {
                                text: root.loop-enabled ? "Loop: On" : "Loop: Off";
                                clicked => {
                                    root.loop-enabled = !root.loop-enabled;
                                    root.loop-changed(root.loop-enabled);
                                }
                            }
                            Text {
                                text: root.audio-current-time + " / " + root.audio-total-duration;
                                color: root.light-theme ? #5c6878 : #aeb8c6;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Volume";
                                color: root.light-theme ? #5c6878 : #aeb8c6;
                                vertical-alignment: center;
                            }
                            Slider {
                                value <=> root.audio-volume;
                                minimum: 0;
                                maximum: 1;
                                width: 110px;
                                changed => { root.volume-changed(self.value); }
                            }
                            Text {
                                text: root.audio-error;
                                color: #d46b32;
                                vertical-alignment: center;
                                overflow: elide;
                                width: 260px;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            LineEdit {
                                placeholder-text: "Filter audio files...";
                                width: 260px;
                                text <=> root.audio-filter;
                                edited(text) => { root.filter-changed(text); }
                            }
                        }
                        Rectangle {
                            background: root.light-theme ? #eef1f5 : #1a2029;
                            border-color: root.light-theme ? #cbd2dc : #2a3340;
                            border-width: 1px;
                            vertical-stretch: 1;
                            if root.audio-rows.length == 0 : Text {
                                text: root.audio-filter == "" ? "No audio files in this folder." : "No matching audio files.";
                                color: root.light-theme ? #5c6878 : #8b96a7;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if root.audio-rows.length > 0 : AudioList {
                                light-theme: root.light-theme;
                                comment-background-color: root.comment-background-color;
                                comment-text-color: root.comment-text-color;
                                rows: root.audio-rows;
                                scroll-to-index: root.audio-scroll-to-index;
                                width: 100%;
                                height: 100%;
                                viewport-changed(start-index) => { root.audio-viewport-changed(start-index); }
                                seek-requested(path, progress) => { root.audio-seek(path, progress); }
                                play-requested(path) => { root.audio-play(path); }
                                comment-range-requested(path, start, end) => { root.comment-range-requested(path, start, end); }
                                comment-selected(path, start, end, text) => { root.comment-selected(path, start, end, text); }
                                comment-edit-requested(path, start, end, text) => { root.comment-edit-requested(path, start, end, text); }
                                comment-range-moved(path, old-start, old-end, start, end, text) => { root.comment-range-moved(path, old-start, old-end, start, end, text); }
                                rating-requested(path, rating) => { root.rating-requested(path, rating); }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: root.metadata-visible ? root.metadata-pane-height + 6px : 0px;
                if root.metadata-visible : VerticalBox {
                    spacing: 0px;
                    Rectangle {
                        height: 6px;
                        background: metadata-drag-area.has-hover ? (root.light-theme ? #aeb8c6 : #566171) : (root.light-theme ? #e0e5eb : #3b4655);
                        metadata-drag-area := TouchArea {
                            mouse-cursor: ns-resize;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down {
                                    root.metadata-drag-start-y = self.mouse-y;
                                    root.metadata-drag-start-height = root.metadata-pane-height;
                                } else if event.kind == PointerEventKind.move && self.pressed {
                                    root.metadata-pane-height = (root.metadata-drag-start-height - (self.mouse-y - root.metadata-drag-start-y)).max(120px).min(420px);
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: root.metadata-pane-height;
                        background: root.light-theme ? #eef1f5 : #1a2029;
                        border-color: root.light-theme ? #cbd2dc : #2a3340;
                        border-width: 1px;
                        VerticalBox {
                            width: 100%;
                            height: 100%;
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                width: 100%;
                                Text { text: root.audio-file-name == "" ? "ComfyUI Metadata" : root.audio-file-name; color: root.light-theme ? #202833 : #e3e8ef; font-size: 16px; overflow: elide; }
                                Rectangle { horizontal-stretch: 1; }
                                Button { text: "Close"; clicked => { root.metadata-toggle(); } }
                            }
                            HorizontalLayout {
                                width: 100%;
                                height: (root.metadata-pane-height - 56px);
                                spacing: 12px;
                                VerticalBox {
                                    width: (parent.width - 36px) / 4;
                                    height: 100%;
                                    alignment: start;
                                    spacing: 6px;
                                    Text { text: "Duration\n" + root.audio-total-duration; color: root.light-theme ? #202833 : #e3e8ef; }
                                    WorkflowSuggestionBox {
                                        width: 100%;
                                        files: root.workflow-json-files;
                                        light-theme: root.light-theme;
                                        list-visible <=> root.workflow-dropdown-visible;
                                        query <=> root.selected-workflow;
                                        selected(path) => { root.workflow-selected(path); }
                                        search-requested(query) => { root.workflow-search-changed(query); }
                                    }
                                    Text { text: "BPM\n" + (root.workflow-bpm == "" ? "-" : root.workflow-bpm) + "\n\nKey\n" + (root.workflow-key == "" ? "-" : root.workflow-key) + "\n\nSeed\n" + (root.workflow-seed == "" ? "-" : root.workflow-seed); color: root.light-theme ? #202833 : #e3e8ef; vertical-alignment: top; }
                                }
                                    VerticalBox {
                                    width: (parent.width - 36px) / 4;
                                    height: 100%;
                                    Text { text: "Prompt"; color: root.light-theme ? #202833 : #e3e8ef; }
                                    TextEdit {
                                        width: 100%;
                                        height: 100%;
                                        text: root.workflow-prompt == "" ? "-" : root.workflow-prompt;
                                        read-only: true;
                                        wrap: word-wrap;
                                    }
                                }
                                VerticalBox {
                                    width: (parent.width - 36px) / 4;
                                    height: 100%;
                                    Text { text: "Lyrics"; color: root.light-theme ? #202833 : #e3e8ef; }
                                    TextEdit {
                                        width: 100%;
                                        height: 100%;
                                        text: root.workflow-lyrics == "" ? "-" : root.workflow-lyrics;
                                        read-only: true;
                                        wrap: word-wrap;
                                    }
                                }
                                VerticalBox {
                                    width: (parent.width - 36px) / 4;
                                    height: 100%;
                                    Text { text: "LoRAs"; color: root.light-theme ? #202833 : #e3e8ef; }
                                    ListView {
                                        height: 100%;
                                        vertical-scrollbar-policy: always-on;
                                        for lora in root.workflow-loras : HorizontalLayout {
                                            height: 26px;
                                            spacing: 4px;
                                            Text {
                                                text: lora.filename + (lora.strength == "" ? "" : "  x" + lora.strength);
                                                color: root.light-theme ? #5c6878 : #aeb8c6;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: lora.custom-tag;
                                                color: root.light-theme ? #202833 : #e3e8ef;
                                                width: 90px;
                                                overflow: elide;
                                            }
                                            Button {
                                                text: "Edit";
                                                clicked => { root.lora-edit-requested(lora.filename, lora.custom-tag); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 32px;
                background: root.light-theme ? #eef1f5 : #1a2029;
                border-color: root.light-theme ? #cbd2dc : #2a3340;
                border-width: 1px;
                Text {
                    text: !root.has-folder ? "No workspace folder opened" : root.selected-name == "" ? "Workspace: " + root.folder-name : "Workspace: " + root.folder-name + "  —  Selected: " + root.selected-name;
                    color: root.light-theme ? #5c6878 : #7f8b9d;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    padding-right: 12px;
                    spacing: 6px;
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.metadata-visible ? "Metadata open" : "";
                        color: root.light-theme ? #5c6878 : #7f8b9d;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    if root.audio-loading : Text {
                        text: root.audio-spinner;
                        color: root.light-theme ? #d46b32 : #e58a4d;
                        font-size: 16px;
                    }
                    Text {
                        text: root.audio-loading ? "Waveforms " + root.audio-completed + "/" + root.audio-total : "";
                        color: root.light-theme ? #5c6878 : #7f8b9d;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.file-menu-visible : Rectangle {
            x: 0px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "Open Folder...";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.file-menu-visible = false;
                    root.open-folder();
                }
            }
        }

        if root.edit-menu-visible : Rectangle {
            x: 70px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "Settings";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.edit-menu-visible = false;
                    root.settings-visible = true;
                }
            }
        }

        if root.help-menu-visible : Rectangle {
            x: 140px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "About";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.help-menu-visible = false;
                    root.about-visible = true;
                }
            }
        }

        if root.tree-menu-visible : Rectangle {
            x: 6px;
            y: 86px;
            width: 210px;
            height: 84px;
            z: 10;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Rectangle {
                width: 100%;
                height: 42px;
                background: rename-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "Rename...  F2";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    width: parent.width - 14px;
                    vertical-alignment: center;
                }
                rename-touch := TouchArea {
                    clicked => {
                        root.tree-menu-visible = false;
                        root.rename-requested();
                    }
                }
            }
            Rectangle {
                y: 42px;
                width: 100%;
                height: 42px;
                background: folder-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "New Folder";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    width: parent.width - 14px;
                    vertical-alignment: center;
                }
                folder-touch := TouchArea {
                    clicked => {
                        root.tree-menu-visible = false;
                        root.new-folder-requested(root.tree-menu-path);
                    }
                }
            }
        }

        if root.about-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            Rectangle {
                width: 390px;
                height: 250px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #202832;
                border-color: #435064;
                border-width: 1px;

                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text {
                        text: "About Adb Studio";
                        color: #f1f4f8;
                        font-size: 22px;
                    }
                    Text { text: "Version 0.1.0"; color: #c4ccd8; }
                    Text { text: "Build: " + root.build-number; color: #c4ccd8; }
                    Text { text: "Author: Alexandre Dupuis-Belin"; color: #c4ccd8; }
                    Rectangle { vertical-stretch: 1; }
                    Button {
                        text: "Close";
                        clicked => { root.close-about(); }
                    }
                }
            }
        }

        if root.settings-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            Rectangle {
                width: 700px;
                height: 390px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;

                HorizontalLayout {
                    Rectangle {
                        width: 170px;
                        background: root.light-theme ? #eef1f5 : #171c24;
                        VerticalBox {
                            padding: 20px;
                            spacing: 12px;
                            Text {
                                text: "Settings";
                                color: root.light-theme ? #202833 : #f1f4f8;
                                font-size: 22px;
                            }
                            Rectangle {
                                height: 38px;
                                background: root.light-theme ? #d7e3f3 : #2a3546;
                                border-color: root.light-theme ? #8ea9c6 : #5d7898;
                                border-width: 1px;
                                Text {
                                    text: "Look Feel";
                                    x: 12px;
                                    color: root.light-theme ? #202833 : #f1f4f8;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        VerticalBox {
                            padding: 24px;
                            spacing: 14px;
                            Text {
                                text: "Look Feel";
                                color: root.light-theme ? #202833 : #f1f4f8;
                                font-size: 22px;
                            }
                            Text {
                                text: "Theme";
                                color: root.light-theme ? #5c6878 : #c4ccd8;
                            }
                            ComboBox {
                                model: ["Dark theme", "Light theme"];
                                current-index: root.theme-index;
                                changed current-index => { root.theme-selected(self.current-index == 1); }
                            }
                            Text {
                                text: "Comment bubbles";
                                color: root.light-theme ? #5c6878 : #c4ccd8;
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "Background"; width: 100px; color: root.light-theme ? #202833 : #e3e8ef; vertical-alignment: center; }
                                Rectangle {
                                    width: 42px;
                                    height: 28px;
                                    background: root.comment-background-color;
                                    border-color: root.comment-text-color;
                                    border-width: 1px;
                                    TouchArea {
                                        clicked => {
                                            root.color-picker-target = 0;
                                            root.color-picker-value = root.comment-background-hex;
                                            root.color-picker-visible = true;
                                        }
                                    }
                                }
                                Text { text: root.comment-background-hex; color: root.light-theme ? #5c6878 : #aeb8c6; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "Text"; width: 100px; color: root.light-theme ? #202833 : #e3e8ef; vertical-alignment: center; }
                                Rectangle {
                                    width: 42px;
                                    height: 28px;
                                    background: root.comment-text-color;
                                    border-color: root.comment-background-color;
                                    border-width: 1px;
                                    TouchArea {
                                        clicked => {
                                            root.color-picker-target = 1;
                                            root.color-picker-value = root.comment-text-hex;
                                            root.color-picker-visible = true;
                                        }
                                    }
                                }
                                Text { text: root.comment-text-hex; color: root.light-theme ? #5c6878 : #aeb8c6; vertical-alignment: center; }
                            }
                            Rectangle { vertical-stretch: 1; }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                Button { text: "Close"; clicked => { root.close-settings(); } }
                            }
                        }
                    }
                }
            }
        }

        if root.settings-visible && root.color-picker-visible : Rectangle {
            x: (parent.width - 360px) / 2;
            y: (parent.height - 300px) / 2;
            width: 360px;
            height: 300px;
            z: 20;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            VerticalBox {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: root.color-picker-target == 0 ? "Background color" : "Text color";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    font-size: 18px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Hex"; width: 50px; color: root.light-theme ? #202833 : #e3e8ef; vertical-alignment: center; }
                    LineEdit { text <=> root.color-picker-value; width: 140px; }
                    Rectangle { width: 42px; height: 28px; background: root.color-picker-target == 0 ? root.comment-background-color : root.comment-text-color; border-color: root.color-picker-target == 0 ? root.comment-text-color : root.comment-background-color; border-width: 1px; }
                }
                Text { text: "Palette"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle { width: 28px; height: 28px; background: #000000; TouchArea { clicked => { root.color-picker-value = "#000000"; } } }
                    Rectangle { width: 28px; height: 28px; background: #ffffff; border-color: #8b96a7; border-width: 1px; TouchArea { clicked => { root.color-picker-value = "#ffffff"; } } }
                    Rectangle { width: 28px; height: 28px; background: #d46b32; TouchArea { clicked => { root.color-picker-value = "#d46b32"; } } }
                    Rectangle { width: 28px; height: 28px; background: #e58a4d; TouchArea { clicked => { root.color-picker-value = "#e58a4d"; } } }
                    Rectangle { width: 28px; height: 28px; background: #2f80ed; TouchArea { clicked => { root.color-picker-value = "#2f80ed"; } } }
                    Rectangle { width: 28px; height: 28px; background: #27ae60; TouchArea { clicked => { root.color-picker-value = "#27ae60"; } } }
                    Rectangle { width: 28px; height: 28px; background: #f2c94c; TouchArea { clicked => { root.color-picker-value = "#f2c94c"; } } }
                    Rectangle { width: 28px; height: 28px; background: #eb5757; TouchArea { clicked => { root.color-picker-value = "#eb5757"; } } }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.color-picker-visible = false; }
                    }
                    Button {
                        text: "Use Color";
                        clicked => {
                            if root.color-picker-target == 0 {
                                root.comment-background-hex = root.color-picker-value;
                            } else {
                                root.comment-text-hex = root.color-picker-value;
                            }
                            root.color-picker-visible = false;
                            root.comment-colors-selected(root.comment-background-hex, root.comment-text-hex);
                        }
                    }
                }
            }
        }

        if root.comment-editor-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            Rectangle {
                width: 430px;
                height: 270px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;
                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text { text: "Comment"; color: root.light-theme ? #202833 : #f1f4f8; font-size: 22px; }
                    LineEdit { placeholder-text: "Start (seconds)"; text <=> root.comment-editor-start; }
                    LineEdit { placeholder-text: "End (seconds)"; text <=> root.comment-editor-end; }
                    LineEdit { placeholder-text: "Comment text"; text <=> root.comment-editor-text; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Save"; clicked => { root.comment-save(root.comment-editor-path, root.comment-editor-start, root.comment-editor-end, root.comment-editor-text); } }
                        Button { text: "Cancel"; clicked => { root.comment-cancel(); } }
                        Button { text: "Delete"; enabled: root.comment-editor-path != ""; clicked => { root.comment-delete(root.comment-editor-path, root.comment-editor-start, root.comment-editor-end, root.comment-editor-text); } }
                    }
                }
            }
        }

        if root.lora-editor-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            Rectangle {
                width: 430px;
                height: 210px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;
                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text { text: "LoRA Info"; color: root.light-theme ? #202833 : #f1f4f8; font-size: 22px; }
                    Text { text: root.lora-editor-filename; color: root.light-theme ? #5c6878 : #c4ccd8; overflow: elide; }
                    LineEdit { placeholder-text: "Custom tag"; text <=> root.lora-editor-tag; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Save"; clicked => { root.lora-save(root.lora-editor-filename, root.lora-editor-tag); } }
                        Button { text: "Cancel"; clicked => { root.lora-cancel(); } }
                    }
                }
            }
        }
    }
}
