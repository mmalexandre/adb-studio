import { Button, LineEdit, VerticalBox } from "std-widgets.slint";

component MenuButton inherits Rectangle {
    width: 70px;
    height: 40px;
    background: root.light-theme ? #eef1f5 : #1a2029;
    callback clicked();
    in property <bool> light-theme;
    in property <string> label;
    Text {
        text: root.label;
        color: root.light-theme ? #202833 : #d7dce5;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component ToolButton inherits Rectangle {
    width: 48px;
    height: 48px;
    background: root.light-theme ? #e7ebf0 : #171c24;
    callback clicked();
    in property <bool> light-theme;
    in property <string> label;
    Text {
        text: root.label;
        color: root.light-theme ? #455160 : #b7c0ce;
        font-size: 22px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Adb Studio";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 560px;
    background: #11151b;

    in-out property <bool> light-theme: false;
    in-out property <bool> has-folder: false;
    in-out property <string> folder-name: "";
    in-out property <string> build-number: "development";
    in-out property <bool> about-visible: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> file-menu-visible: false;
    in-out property <bool> edit-menu-visible: false;
    in-out property <bool> help-menu-visible: false;
    callback open-folder();
    callback close-about();
    callback close-settings();
    callback theme-selected(bool);

    Rectangle {
        background: root.light-theme ? #f5f7fa : #11151b;

        VerticalBox {
            spacing: 0px;

            Rectangle {
                height: 40px;
                background: root.light-theme ? #eef1f5 : #1a2029;
                border-color: root.light-theme ? #cbd2dc : #2a3340;
                border-width: 1px;

                HorizontalLayout {
                    spacing: 0px;
                    MenuButton {
                        label: "File";
                        light-theme: root.light-theme;
                        clicked => {
                            root.file-menu-visible = !root.file-menu-visible;
                            root.edit-menu-visible = false;
                            root.help-menu-visible = false;
                        }
                    }
                    MenuButton {
                        label: "Edit";
                        light-theme: root.light-theme;
                        clicked => {
                            root.edit-menu-visible = !root.edit-menu-visible;
                            root.file-menu-visible = false;
                            root.help-menu-visible = false;
                        }
                    }
                    MenuButton {
                        label: "Help";
                        light-theme: root.light-theme;
                        clicked => {
                            root.help-menu-visible = !root.help-menu-visible;
                            root.file-menu-visible = false;
                            root.edit-menu-visible = false;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 110px;
                        Text {
                            text: "Adb Studio";
                            width: parent.width - 14px;
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            font-size: 13px;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                Rectangle {
                    width: 48px;
                    background: root.light-theme ? #e7ebf0 : #171c24;
                    border-color: root.light-theme ? #cbd2dc : #2a3340;
                    border-width: 1px;

                    VerticalBox {
                        alignment: start;
                        ToolButton {
                            label: "▤";
                            light-theme: root.light-theme;
                            clicked => { }
                        }
                    }
                }

                Rectangle {
                    width: 280px;
                    background: root.light-theme ? #eef1f5 : #1a2029;
                    border-color: root.light-theme ? #cbd2dc : #2a3340;
                    border-width: 1px;

                    if root.has-folder : VerticalBox {
                        padding: 18px;
                        spacing: 12px;
                        Text {
                            text: "EXPLORER";
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            font-size: 11px;
                        }
                        Text {
                            text: root.folder-name;
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 15px;
                            overflow: elide;
                        }
                        Rectangle {
                            height: 1px;
                            background: root.light-theme ? #cbd2dc : #2a3340;
                        }
                        Text {
                            text: "Folder contents will appear here";
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }

                    if !root.has-folder : VerticalBox {
                        padding: 18px;
                        spacing: 12px;
                        Text {
                            text: "EXPLORER";
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            font-size: 11px;
                        }
                        Text {
                            text: "No folder open";
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 15px;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Rectangle {
                    background: root.light-theme ? #f5f7fa : #11151b;
                    horizontal-stretch: 1;

                    if !root.has-folder : VerticalBox {
                        alignment: center;
                        spacing: 14px;
                        Text {
                            text: "Welcome to Adb Studio";
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 28px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Open a workspace folder to begin organizing your audio.";
                            color: root.light-theme ? #5c6878 : #8b96a7;
                            horizontal-alignment: center;
                        }
                        Button {
                            text: "Open Folder...";
                            clicked => { root.open-folder(); }
                        }
                    }

                    if root.has-folder : VerticalBox {
                        padding: 24px;
                        spacing: 18px;
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Audio Library";
                                color: root.light-theme ? #202833 : #e3e8ef;
                                font-size: 24px;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            LineEdit {
                                placeholder-text: "Filter audio files...";
                                width: 260px;
                            }
                        }
                        Rectangle {
                            background: root.light-theme ? #eef1f5 : #1a2029;
                            border-color: root.light-theme ? #cbd2dc : #2a3340;
                            border-width: 1px;
                            vertical-stretch: 1;
                            Text {
                                text: "Select a folder in the explorer to view its audio files.";
                                color: root.light-theme ? #5c6878 : #8b96a7;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 32px;
                background: root.light-theme ? #eef1f5 : #1a2029;
                border-color: root.light-theme ? #cbd2dc : #2a3340;
                border-width: 1px;
                Text {
                    text: root.has-folder ? "Workspace: " + root.folder-name : "No workspace folder opened";
                    color: root.light-theme ? #5c6878 : #7f8b9d;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        if root.file-menu-visible : Rectangle {
            x: 0px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "Open Folder...";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.file-menu-visible = false;
                    root.open-folder();
                }
            }
        }

        if root.edit-menu-visible : Rectangle {
            x: 70px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "Settings";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.edit-menu-visible = false;
                    root.settings-visible = true;
                }
            }
        }

        if root.help-menu-visible : Rectangle {
            x: 140px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "About";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.help-menu-visible = false;
                    root.about-visible = true;
                }
            }
        }

        if root.about-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            Rectangle {
                width: 390px;
                height: 250px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #202832;
                border-color: #435064;
                border-width: 1px;

                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text {
                        text: "About Adb Studio";
                        color: #f1f4f8;
                        font-size: 22px;
                    }
                    Text { text: "Version 0.1.0"; color: #c4ccd8; }
                    Text { text: "Build: " + root.build-number; color: #c4ccd8; }
                    Text { text: "Author: Alexandre Dupuis-Belin"; color: #c4ccd8; }
                    Rectangle { vertical-stretch: 1; }
                    Button {
                        text: "Close";
                        clicked => { root.close-about(); }
                    }
                }
            }
        }

        if root.settings-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            Rectangle {
                width: 430px;
                height: 230px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;

                VerticalBox {
                    padding: 24px;
                    spacing: 14px;
                    Text {
                        text: "Settings";
                        color: root.light-theme ? #202833 : #f1f4f8;
                        font-size: 22px;
                    }
                    Text {
                        text: "Appearance";
                        color: root.light-theme ? #5c6878 : #c4ccd8;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Button {
                            text: "Light theme";
                            clicked => { root.theme-selected(true); }
                        }
                        Button {
                            text: "Dark theme";
                            clicked => { root.theme-selected(false); }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Button {
                        text: "Close";
                        clicked => { root.close-settings(); }
                    }
                }
            }
        }
    }
}
