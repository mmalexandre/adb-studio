import { CheckBox, ComboBox, LineEdit, ListView, Palette, ScrollView, Slider, SpinBox, TextEdit, VerticalBox } from "std-widgets.slint";
import { AudioRow, BreadcrumbRow, CommentRow, ConversionRow, TrackDifference, TreeRow, WorkflowFileRow, WorkflowLoraRow } from "./models.slint";
import { AppButton, CompactIconButton, IconButton, MenuButton, SortIconButton, SyncIconButton, ToolButton } from "./controls.slint";
import { Waveform } from "./waveform.slint";
import { AudioList, ExplorerList } from "./views.slint";

export component MainWindow inherits Window {
    title: "Adb Studio";
    no-frame: true;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 560px;
    background: #11151b;
    forward-focus: keyboard-focus;

    in-out property <bool> light-theme: false;
    in-out property <color> comment-background-color: #000000;
    in-out property <color> comment-text-color: #ffffff;
    in-out property <string> comment-background-hex: "#000000";
    in-out property <string> comment-text-hex: "#ffffff";
    in-out property <int> theme-index: 0;
    in-out property <bool> color-picker-visible: false;
    in-out property <int> color-picker-target: 0;
    in-out property <string> color-picker-value: "#000000";
    in-out property <bool> has-folder: false;
    in-out property <string> folder-name: "";
    in-out property <string> build-number: "development";
    in-out property <bool> about-visible: false;
    in-out property <bool> settings-visible: false;
    in-out property <int> settings-tab: 0;
    in-out property <bool> tips-visible: false;
    in-out property <bool> hide-tips-of-the-day: false;
    in-out property <bool> comfyui-sync-visible: false;
    in-out property <string> comfyui-sync-url: "";
    in-out property <string> comfyui-sync-remote-directory: "output/audio";
    in-out property <string> comfyui-sync-local-directory: "downloads";
    in-out property <string> comfyui-sync-interval: "4000";
    in-out property <string> comfyui-sync-error: "";
    in-out property <string> comfyui-sync-test-message: "";
    in-out property <bool> comfyui-sync-test-success: false;
    in-out property <string> comfyui-sync-status: "Not configured";
    in-out property <string> comfyui-sync-spinner: "|";
    in-out property <int> comfyui-sync-present: 0;
    in-out property <int> comfyui-sync-total: 0;
    in-out property <bool> comfyui-sync-active: false;
    in-out property <bool> comfyui-sync-error-state: false;
    in-out property <bool> file-menu-visible: false;
    in-out property <bool> edit-menu-visible: false;
    in-out property <bool> view-menu-visible: false;
    in-out property <bool> help-menu-visible: false;
    in-out property <bool> tree-menu-visible: false;
    in-out property <bool> sort-menu-visible: false;
    in-out property <int> sort-order: 3;
    in-out property <string> tree-menu-path: "";
    in-out property <length> tree-menu-x: 0px;
    in-out property <length> tree-menu-y: 0px;
    in-out property <string> tree-edit-path: "";
    in-out property <string> tree-edit-text: "";
    in-out property <int> tree-edit-mode: 0;
    in-out property <bool> conversion-options-visible: false;
    in-out property <bool> conversion-progress-visible: false;
    in-out property <int> conversion-format-index: 0;
    in-out property <int> conversion-quality-index: 1;
    property <[string]> conversion-quality-labels: root.conversion-format-index == 0
        ? ["96 kbps", "128 kbps", "192 kbps", "320 kbps (maximum)"]
        : root.conversion-format-index == 1
        ? ["96 kbps", "128 kbps", "192 kbps", "256 kbps (maximum)"]
        : root.conversion-format-index == 2
        ? ["64 kbps", "96 kbps", "128 kbps", "192 kbps (maximum)"]
        : root.conversion-format-index == 3
        ? ["Compression level 1", "Compression level 5", "Compression level 8", "Compression level 12 (maximum)"]
        : ["PCM 16-bit", "PCM 24-bit", "PCM 32-bit", "PCM 32-bit float (maximum)"];
    property <[string]> conversion-quality-values: ["Low", "Medium", "High", "Maximum"];
    in-out property <[ConversionRow]> conversion-rows: [];
    in-out property <bool> conversion-complete: false;
    in-out property <bool> left-pane-visible: true;
    in-out property <length> left-pane-width: 280px;
    callback left-pane-width-changed(length);
    in-out property <[TreeRow]> tree-rows: [];
    in-out property <int> tree-selection-count: 1;
    in-out property <int> tree-scroll-to-index: -1;
    in-out property <[BreadcrumbRow]> audio-breadcrumbs: [];
    in-out property <[AudioRow]> audio-rows: [];
    in-out property <int> audio-scroll-to-index: -1;
    in-out property <int> audio-viewport-start: 0;
    in-out property <int> audio-visible-rows: 0;
    in-out property <string> audio-filter: "";
    in-out property <string> selected-name: "";
    in-out property <bool> audio-loading: false;
    in-out property <int> audio-completed: 0;
    in-out property <int> audio-total: 0;
    in-out property <string> audio-spinner: "|";
    in-out property <string> active-audio-path: "";
    in-out property <string> selected-audio-path: "";
    in-out property <string> audio-file-name: "";
    in-out property <bool> audio-playing: false;
    in-out property <int> loop-mode: 0;
    in-out property <bool> auto-play-new-tracks: false;
    in-out property <int> seek-seconds: 5;
    in-out property <int> shortcut-fullscreen: 0;
    in-out property <int> shortcut-metadata: 1;
    in-out property <int> shortcut-play-pause: 2;
    in-out property <int> shortcut-navigate-up: 3;
    in-out property <int> shortcut-navigate-down: 4;
    in-out property <int> shortcut-cancel-edit: 5;
    in-out property <int> shortcut-seek-backward: 7;
    in-out property <int> shortcut-seek-forward: 8;
    in-out property <int> shortcut-trash: 9;
    property <bool> text-input-focused: false;
    in-out property <float> audio-volume: 1.0;
    in-out property <string> audio-current-time: "00:00";
    in-out property <string> audio-total-duration: "00:00";
    in-out property <string> audio-error: "";
    in-out property <bool> trash-confirm-visible: false;
    in-out property <string> trash-confirm-path: "";
    in-out property <bool> trash-confirm-dont-ask: false;
    in-out property <bool> workflow-save-confirm-visible: false;
    in-out property <bool> workflow-save-confirm-dont-ask: false;
    in-out property <bool> metadata-visible: true;
    in-out property <length> metadata-pane-height: 320px;
    property <length> metadata-drag-start-y: 0px;
    property <length> metadata-drag-start-height: 320px;
    in-out property <[WorkflowFileRow]> workflow-json-files: [];
    in-out property <string> selected-workflow: "";
    in-out property <bool> workflow-dropdown-visible: false;
    in-out property <string> workflow-bpm: "";
    in-out property <int> workflow-bpm-number: 0;
    in-out property <string> workflow-key: "";
    in-out property <int> workflow-key-index: -1;
    in-out property <string> workflow-seed: "";
    in-out property <int> workflow-seed-number: 0;
    in-out property <string> workflow-model: "";
    in-out property <string> workflow-prompt: "";
    in-out property <string> workflow-lyrics: "";
    in-out property <string> user-comments: "";
    in-out property <[WorkflowLoraRow]> workflow-loras: [];
    in-out property <bool> workflow-modified: false;
    in-out property <bool> workflow-recreated: false;
    in-out property <bool> workflow-loading: false;
    in-out property <bool> comfyui-run-visible: false;
    in-out property <float> comfyui-run-progress: 0;
    in-out property <string> comfyui-run-step: "";
    in-out property <bool> comfyui-run-cancel-requested: false;
    in-out property <bool> comfyui-run-complete: false;
    in-out property <bool> lora-editor-visible: false;
    in-out property <string> lora-editor-filename: "";
    in-out property <string> lora-editor-tag: "";
    in-out property <bool> splash-visible: true;
    callback open-folder();
    callback close-folder();
    callback close-about();
    callback close-settings();
    callback close-tips();
    callback tips-preference-changed(bool);
    callback comfyui-sync-requested();
    callback comfyui-sync-save(string, string, string, string);
    callback comfyui-sync-test(string, string, string, string);
    callback comfyui-sync-cancel();
    callback comfyui-sync-choose-directory();
    callback toggle-fullscreen();
    callback theme-selected(bool);
    callback comment-colors-selected(string, string);
    callback row-clicked(string, bool);
    callback chevron-clicked(string);
    callback breadcrumb-requested(string);
    callback audio-row-selected(string);
    callback audio-row-clicked(string, bool);
    callback audio-navigate(int);
    callback tree-context-menu(string);
    callback conversion-requested(string);
    callback conversion-started(string, string);
    callback conversion-cancelled();
    callback conversion-closed();
    callback sort-order-selected(int);
    callback tree-trash-requested(string);
    callback tree-drop-requested(string, int);
    callback rename-requested();
    callback tree-reveal-requested(string);
    callback new-folder-requested(string);
    callback tree-edit-accepted(string, string, int);
    callback tree-edit-cancelled();
    callback filter-changed(string);
    callback audio-viewport-changed(int, int);
    callback audio-play-pause();
    callback audio-seek(string, float);
    callback audio-play(string);
    callback loop-changed(int);
    callback auto-play-new-tracks-changed(bool);
    callback seek-seconds-changed(int);
    callback shortcut-changed(int, int);
    callback global-key-pressed(int, bool);
    callback rating-key-pressed(int);
    callback volume-changed(float);
    callback comment-range-requested(string, float, float);
    callback comment-selected(string, float, float, string);
    callback comment-edit-requested(string, float, float, string);
    callback comment-range-moved(string, float, float, float, float, string);
    callback rating-requested(string, int);
    callback pin-requested(string);
    callback trash-requested(string);
    callback trash-confirmed(bool);
    callback trash-cancelled();
    callback workflow-save-confirmed(bool);
    callback workflow-save-cancelled();
    callback comment-save(string, string, string, string);
    callback comment-cancel();
    callback comment-delete(string, string, string, string);
    callback metadata-toggle();
    callback metadata-pane-height-changed(length);
    callback assign-workflow-requested();
    callback save-workflow-requested();
    callback recreate-workflow-requested();
    callback open-workflow-requested();
    callback run-workflow-requested();
    callback run-workflow-cancelled();
    callback run-workflow-closed();
    callback workflow-metadata-changed(string, string);
    callback workflow-number-changed(string, int);
    callback user-comments-changed(string);
    callback lora-edit-requested(string, string);
    callback lora-save(string, string);
    callback lora-cancel();
    in-out property <bool> comment-editor-visible: false;
    in-out property <string> comment-editor-path: "";
    in-out property <string> comment-editor-start: "0";
    in-out property <string> comment-editor-end: "0";
    in-out property <string> comment-editor-text: "";

    changed left-pane-width => {
        root.left-pane-width-changed(root.left-pane-width);
    }

    changed metadata-pane-height => {
        root.metadata-pane-height-changed(root.metadata-pane-height);
    }

    init => {
        Palette.color-scheme = root.light-theme ? ColorScheme.light : ColorScheme.dark;
    }

    changed light-theme => {
        Palette.color-scheme = root.light-theme ? ColorScheme.light : ColorScheme.dark;
    }

    keyboard-focus := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && event.text == "," {
                root.settings-visible = true;
                accept;
            }
            if (root.text-input-focused || root.tree-edit-path != "") && (
                event.text == Key.Space
                || event.text == "0"
                || event.text == "1"
                || event.text == "2"
                || event.text == "3"
                || event.text == "4"
                || event.text == "5"
                || event.text == Key.UpArrow
                || event.text == Key.DownArrow
                || event.text == Key.LeftArrow
                || event.text == Key.RightArrow
                || event.text == Key.Delete
            ) { reject; }
            if event.text == Key.F11 { root.global-key-pressed(0, event.modifiers.shift); accept; }
            if event.text == Key.F9 { root.global-key-pressed(1, event.modifiers.shift); accept; }
            if event.text == Key.Space { root.global-key-pressed(2, event.modifiers.shift); accept; }
            if event.text == Key.UpArrow { root.global-key-pressed(3, event.modifiers.shift); accept; }
            if event.text == Key.DownArrow { root.global-key-pressed(4, event.modifiers.shift); accept; }
            if event.text == Key.Escape { root.global-key-pressed(5, event.modifiers.shift); accept; }
            if event.text == Key.F2 { root.global-key-pressed(6, event.modifiers.shift); accept; }
            if event.text == Key.LeftArrow { root.global-key-pressed(7, event.modifiers.shift); accept; }
            if event.text == Key.RightArrow { root.global-key-pressed(8, event.modifiers.shift); accept; }
            if event.text == Key.Delete { root.global-key-pressed(9, event.modifiers.shift); accept; }
            if event.text == "0" { root.rating-key-pressed(0); accept; }
            if event.text == "1" { root.rating-key-pressed(1); accept; }
            if event.text == "2" { root.rating-key-pressed(2); accept; }
            if event.text == "3" { root.rating-key-pressed(3); accept; }
            if event.text == "4" { root.rating-key-pressed(4); accept; }
            if event.text == "5" { root.rating-key-pressed(5); accept; }
            reject;
        }

    Rectangle {
        background: root.light-theme ? #f5f7fa : #11151b;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.workflow-dropdown-visible = false;
                root.tree-menu-visible = false;
                root.sort-menu-visible = false;
                if root.tree-edit-path != "" {
                    root.tree-edit-cancelled();
                }
            }
        }

        VerticalBox {
            spacing: 0px;

            Rectangle {
                height: 35px;
                background: root.light-theme ? #eef1f5 : #1a2029;
                border-color: root.light-theme ? #cbd2dc : #2a3340;
                border-width: 1px;

                HorizontalLayout {
                    spacing: 0px;
                    MenuButton {
                        label: "File";
                        light-theme: root.light-theme;
                        clicked => {
                            root.file-menu-visible = !root.file-menu-visible;
                            root.edit-menu-visible = false;
                            root.view-menu-visible = false;
                            root.help-menu-visible = false;
                        }
                    }
                    MenuButton {
                        label: "Edit";
                        light-theme: root.light-theme;
                        clicked => {
                            root.edit-menu-visible = !root.edit-menu-visible;
                            root.file-menu-visible = false;
                            root.view-menu-visible = false;
                            root.help-menu-visible = false;
                        }
                    }
                    MenuButton {
                        label: "View";
                        light-theme: root.light-theme;
                        clicked => {
                            root.view-menu-visible = !root.view-menu-visible;
                            root.file-menu-visible = false;
                            root.edit-menu-visible = false;
                            root.help-menu-visible = false;
                        }
                    }
                    MenuButton {
                        label: "Help";
                        light-theme: root.light-theme;
                        clicked => {
                            root.help-menu-visible = !root.help-menu-visible;
                            root.file-menu-visible = false;
                            root.edit-menu-visible = false;
                            root.view-menu-visible = false;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 110px;
                        Text {
                            text: "Adb Studio";
                            width: parent.width - 14px;
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            font-size: 13px;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 35px;
                        height: 35px;
                        border-radius: 17.5px;
                        background: minimize-area.has-hover ? (root.light-theme ? #dfe4ea : #2a3340) : transparent;
                        Image {
                            source: @image-url("../assets/icons/minimize.svg");
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 13px;
                            height: 13px;
                            colorize: root.light-theme ? #202833 : #f1f4f8;
                        }
                        minimize-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.minimized = true; }
                        }
                    }
                    Rectangle {
                        width: 35px;
                        height: 35px;
                        border-radius: 17.5px;
                        background: maximize-area.has-hover ? (root.light-theme ? #dfe4ea : #2a3340) : transparent;
                        Image {
                            source: @image-url("../assets/icons/maximize.svg");
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 13px;
                            height: 13px;
                            colorize: root.light-theme ? #202833 : #f1f4f8;
                        }
                        maximize-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.maximized = !root.maximized; }
                        }
                    }
                    Rectangle {
                        width: 35px;
                        height: 35px;
                        border-radius: 17.5px;
                        background: close-area.has-hover ? #c94f45 : transparent;
                        Image {
                            source: @image-url("../assets/icons/x.svg");
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 13px;
                            height: 13px;
                            colorize: root.light-theme ? #202833 : #f1f4f8;
                        }
                        close-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close(); }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                Rectangle {
                    width: 48px;
                    background: root.light-theme ? #e7ebf0 : #171c24;
                    border-color: root.light-theme ? #cbd2dc : #2a3340;
                    border-width: 1px;

                    VerticalBox {
                        alignment: start;
                        ToolButton {
                            icon: @image-url("../assets/icons/panel-left.svg");
                            light-theme: root.light-theme;
                            clicked => { root.left-pane-visible = !root.left-pane-visible; }
                        }
                    }
                }

                if root.left-pane-visible : Rectangle {
                    width: root.left-pane-width;
                    background: root.light-theme ? #eef1f5 : #1a2029;
                    border-color: root.light-theme ? #cbd2dc : #2a3340;
                    border-width: 1px;

                    if root.has-folder : VerticalBox {
                        padding: 18px;
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        Rectangle {
                            height: 28px;
                            z: 100;
                            HorizontalLayout {
                                Text {
                                    text: "EXPLORER";
                                    color: root.light-theme ? #5c6878 : #7f8b9d;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        Text {
                            text: root.folder-name;
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 15px;
                            overflow: elide;
                            x: 12px;
                        }
                        Rectangle {
                            height: 1px;
                            background: root.light-theme ? #cbd2dc : #2a3340;
                        }
                        tree-focus := FocusScope {
                            vertical-stretch: 1;
                            key-pressed(event) => {
                                if event.text == Key.F2 {
                                    root.rename-requested();
                                    accept;
                                }
                                reject;
                            }
                            tree-list := ExplorerList {
                                width: 100%;
                                height: 100%;
                                light-theme: root.light-theme;
                                rows: root.tree-rows;
                                selected-count: root.tree-selection-count;
                                edit-path: root.tree-edit-path;
                                edit-text <=> root.tree-edit-text;
                                scroll-to-index: root.tree-scroll-to-index;
                                row-clicked(path, shift) => {
                                    root.tree-menu-visible = false;
                                    if root.tree-edit-path != "" && root.tree-edit-path != path {
                                        root.tree-edit-cancelled();
                                    } else {
                                        tree-focus.focus();
                                        root.row-clicked(path, shift);
                                    }
                                }
                                chevron-clicked(path) => {
                                    root.tree-menu-visible = false;
                                    root.chevron-clicked(path);
                                }
                                tree-context-menu(path, x, y) => {
                                    if root.tree-edit-path != "" && root.tree-edit-path != path {
                                        root.tree-edit-cancelled();
                                    }
                                    root.file-menu-visible = false;
                                    root.edit-menu-visible = false;
                                    root.view-menu-visible = false;
                                    root.help-menu-visible = false;
                                    tree-focus.focus();
                                    root.tree-menu-path = path;
                                    root.tree-menu-x = x;
                                    root.tree-menu-y = y;
                                    root.tree-menu-visible = true;
                                }
                                tree-trash-requested(path) => { root.tree-trash-requested(path); }
                                tree-drop-requested(path, index) => { root.tree-drop-requested(path, index); }
                                edit-accepted(path, text) => { root.tree-edit-accepted(path, text, root.tree-edit-mode); }
                                edit-cancelled => { root.tree-edit-cancelled(); }
                            }
                            }
                    }

                    if !root.has-folder : VerticalBox {
                        padding: 18px;
                        spacing: 12px;
                        Text {
                            text: "EXPLORER";
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            font-size: 11px;
                        }
                        Text {
                            text: "No folder open";
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 15px;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                if root.left-pane-visible : Rectangle {
                    width: 6px;
                    background: drag-area.has-hover ? (root.light-theme ? #aeb8c6 : #566171) : (root.light-theme ? #e0e5eb : #3b4655);

                    VerticalBox {
                        alignment: center;
                        spacing: 2px;
                        Rectangle {
                            width: 3px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: drag-area.has-hover ? (root.light-theme ? #f5f7fa : #d7dce5) : (root.light-theme ? #8b96a7 : #8b96a7);
                        }
                        Rectangle {
                            width: 3px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: drag-area.has-hover ? (root.light-theme ? #f5f7fa : #d7dce5) : (root.light-theme ? #8b96a7 : #8b96a7);
                        }
                        Rectangle {
                            width: 3px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: drag-area.has-hover ? (root.light-theme ? #f5f7fa : #d7dce5) : (root.light-theme ? #8b96a7 : #8b96a7);
                        }
                    }

                    drag-area := TouchArea {
                        mouse-cursor: ew-resize;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.move && self.pressed {
                                root.left-pane-width = (parent.x + self.mouse-x - 48px).max(180px).min(600px);
                            }
                        }
                    }
                }

                Rectangle {
                    background: root.light-theme ? #f5f7fa : #11151b;
                    horizontal-stretch: 1;

                    if !root.has-folder : VerticalBox {
                        alignment: center;
                        spacing: 14px;
                        Text {
                            text: "Welcome to Adb Studio";
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 28px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Open a workspace folder to begin organizing your audio.";
                            color: root.light-theme ? #5c6878 : #8b96a7;
                            horizontal-alignment: center;
                        }
                        AppButton {
                            text: "Open Folder...";
                            clicked => { root.open-folder(); }
                        }
                    }

                    if root.has-folder : VerticalBox {
                        padding: 24px;
                        padding-bottom: 0px;
                        spacing: 18px;
                        Rectangle {
                            height: 28px;
                            HorizontalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    spacing: 0px;
                                    for breadcrumb[index] in root.audio-breadcrumbs : Rectangle {
                                        height: 28px;
                                        width: breadcrumb-name.preferred-width + (index < root.audio-breadcrumbs.length - 1 ? 42px : 0px);
                                        breadcrumb-name := Text {
                                            text: breadcrumb.name;
                                            color: index < root.audio-breadcrumbs.length - 1 ? (root.light-theme ? #5c6878 : #8b96a7) : (root.light-theme ? #202833 : #e3e8ef);
                                            font-size: 18px;
                                            vertical-alignment: center;
                                        }
                                        if index < root.audio-breadcrumbs.length - 1 : Text {
                                            text: ">";
                                            x: breadcrumb-name.x + breadcrumb-name.width + 4px;
                                            color: root.light-theme ? #8b96a7 : #687487;
                                            font-size: 16px;
                                            vertical-alignment: center;
                                        }
                                        if index < root.audio-breadcrumbs.length - 1 : TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.breadcrumb-requested(breadcrumb.path); }
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                LineEdit {
                                    placeholder-text: "Filter audio files...";
                                    width: 260px;
                                    text <=> root.audio-filter;
                                    edited(text) => { root.filter-changed(text); }
                                    changed has-focus => { root.text-input-focused = self.has-focus; }
                                }
                                SortIconButton {
                                    icon: @image-url("../assets/icons/ellipsis-vertical.svg");
                                    light-theme: root.light-theme;
                                    clicked => { root.sort-menu-visible = !root.sort-menu-visible; }
                                }
                            }
                        }
                        Rectangle {
                            background: root.light-theme ? #eef1f5 : #1a2029;
                            border-color: root.light-theme ? #cbd2dc : #2a3340;
                            border-width: 1px;
                            vertical-stretch: 1;
                            if root.audio-rows.length == 0 : Text {
                                text: root.audio-filter == "" ? "No audio files in this folder." : "No matching audio files.";
                                color: root.light-theme ? #5c6878 : #8b96a7;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if root.audio-rows.length > 0 : AudioList {
                                light-theme: root.light-theme;
                                comment-background-color: root.comment-background-color;
                                comment-text-color: root.comment-text-color;
                                rows: root.audio-rows;
                                scroll-to-index: root.audio-scroll-to-index;
                                width: 100%;
                                height: 100%;
                                viewport-changed(start-index, visible-rows) => {
                                    root.audio-viewport-start = start-index;
                                    root.audio-visible-rows = visible-rows;
                                    root.audio-viewport-changed(start-index, visible-rows);
                                }
                                row-selected(path) => { root.audio-row-selected(path); }
                                row-clicked(path, shift) => { root.audio-row-clicked(path, shift); }
                                seek-requested(path, progress) => { root.audio-seek(path, progress); }
                                play-requested(path) => { root.audio-play(path); }
                                comment-range-requested(path, start, end) => { root.comment-range-requested(path, start, end); }
                                comment-selected(path, start, end, text) => { root.comment-selected(path, start, end, text); }
                                comment-edit-requested(path, start, end, text) => { root.comment-edit-requested(path, start, end, text); }
                                comment-range-moved(path, old-start, old-end, start, end, text) => { root.comment-range-moved(path, old-start, old-end, start, end, text); }
                                rating-requested(path, rating) => { root.rating-requested(path, rating); }
                                pin-requested(path) => { root.pin-requested(path); }
                                trash-requested(path) => { root.trash-requested(path); }
                            }
                            if root.sort-menu-visible : Rectangle {
                                x: parent.width - 196px;
                                y: -14px;
                                width: 190px;
                                height: 128px;
                                z: 1000;
                                background: root.light-theme ? #ffffff : #202832;
                                border-color: root.light-theme ? #cbd2dc : #435064;
                                border-width: 1px;
                                for option[index] in ["Alphabetically ↑", "Alphabetically ↓", "Modified ↑", "Modified ↓"] : Rectangle {
                                    y: index * 31px;
                                    width: parent.width;
                                    height: 31px;
                                    background: root.sort-order == index ? (root.light-theme ? #e7ebf0 : #2a3543) : transparent;
                                    Text {
                                        text: option;
                                        x: 10px;
                                        color: root.light-theme ? #202833 : #d7dce5;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.sort-order = index;
                                            root.sort-menu-visible = false;
                                            root.sort-order-selected(index);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: root.metadata-visible ? root.metadata-pane-height + 26px : 0px;
                z: 1;
                if root.metadata-visible : VerticalBox {
                    spacing: 0px;
                    Rectangle {
                        height: 6px;
                        background: metadata-drag-area.has-hover ? (root.light-theme ? #aeb8c6 : #566171) : (root.light-theme ? #e0e5eb : #3b4655);
                        metadata-drag-area := TouchArea {
                            mouse-cursor: ns-resize;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down {
                                    root.metadata-drag-start-y = self.mouse-y;
                                    root.metadata-drag-start-height = root.metadata-pane-height;
                                } else if event.kind == PointerEventKind.move && self.pressed {
                                    root.metadata-pane-height = (root.metadata-drag-start-height - (self.mouse-y - root.metadata-drag-start-y)).max(120px).min(420px);
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: root.metadata-pane-height + 20px;
                        background: root.light-theme ? #eef1f5 : #1a2029;
                        border-color: root.workflow-modified ? #d46b32 : (root.light-theme ? #cbd2dc : #2a3340);
                        border-width: 5px;
                        CompactIconButton {
                            x: parent.width - self.width - 6px;
                            y: 6px;
                            icon: @image-url("../assets/icons/x.svg");
                            clicked => { root.metadata-toggle(); }
                        }
                        VerticalBox {
                            width: 100%;
                            height: 100%;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 12px;
                            padding-bottom: 27px;
                            spacing: 8px;
                            HorizontalLayout {
                                width: 100%;
                                height: (root.metadata-pane-height - 58px);
                                spacing: 12px;
                                VerticalBox {
                                    width: (parent.width - 36px) / 4;
                                    height: 100%;
                                    alignment: start;
                                    spacing: 6px;
                                    Text { text: "Duration\n" + root.audio-total-duration; color: root.light-theme ? #202833 : #e3e8ef; }
                                    Text { text: "BPM"; color: root.light-theme ? #202833 : #e3e8ef; }
                                    SpinBox {
                                        minimum: 0;
                                        maximum: 2147483647;
                                        value <=> root.workflow-bpm-number;
                                        edited(value) => { root.workflow-number-changed("bpm", value); }
                                        changed has-focus => { root.text-input-focused = self.has-focus; }
                                    }
                                    Text { text: "Key"; color: root.light-theme ? #202833 : #e3e8ef; }
                                    ComboBox {
                                        model: ["C major", "C minor", "C# major", "C# minor", "D major", "D minor", "Eb major", "Eb minor", "E major", "E minor", "F major", "F minor", "F# major", "F# minor", "G major", "G minor", "Ab major", "Ab minor", "A major", "A minor", "Bb major", "Bb minor", "B major", "B minor"];
                                        current-index: root.workflow-key-index;
                                        changed has-focus => { root.text-input-focused = self.has-focus; }
                                        changed current-index => {
                                            if self.has-focus && !root.workflow-loading && self.current-index >= 0 {
                                                root.workflow-metadata-changed("key", self.model[self.current-index]);
                                            }
                                        }
                                    }
                                    Text { text: "Seed"; color: root.light-theme ? #202833 : #e3e8ef; }
                                    SpinBox {
                                        minimum: 0;
                                        maximum: 2147483647;
                                        value <=> root.workflow-seed-number;
                                        edited(value) => { root.workflow-number-changed("seed", value); }
                                        changed has-focus => { root.text-input-focused = self.has-focus; }
                                    }
                                }
                                    VerticalBox {
                                    width: (parent.width - 36px) / 4;
                                    height: 100%;
                                    Text { text: "Prompt"; color: root.light-theme ? #202833 : #e3e8ef; }
                                    TextEdit {
                                        width: 100%;
                                        height: 100%;
                                        text <=> root.workflow-prompt;
                                        wrap: word-wrap;
                                        edited(text) => { root.workflow-metadata-changed("prompt", text); }
                                        changed has-focus => { root.text-input-focused = self.has-focus; }
                                    }
                                }
                                VerticalBox {
                                    width: (parent.width - 36px) / 4;
                                    height: 100%;
                                    Text { text: "Lyrics"; color: root.light-theme ? #202833 : #e3e8ef; }
                                    TextEdit {
                                        width: 100%;
                                        height: 100%;
                                        text <=> root.workflow-lyrics;
                                        wrap: word-wrap;
                                        edited(text) => { root.workflow-metadata-changed("lyrics", text); }
                                        changed has-focus => { root.text-input-focused = self.has-focus; }
                                    }
                                }
                                VerticalBox {
                                    width: (parent.width - 36px) / 4;
                                    height: 100%;
                                    Text { text: "Model\n" + (root.workflow-model == "" ? "-" : root.workflow-model); color: root.light-theme ? #202833 : #e3e8ef; overflow: elide; }
                                    Text { text: "LoRAs"; color: root.light-theme ? #202833 : #e3e8ef; }
                                    ListView {
                                        height: (root.workflow-loras.length * 26px).min(130px);
                                        vertical-scrollbar-policy: always-on;
                                        for lora in root.workflow-loras : HorizontalLayout {
                                            height: 26px;
                                            spacing: 4px;
                                            Text {
                                                text: lora.filename + (lora.strength == "" ? "" : "  x" + lora.strength);
                                                color: root.workflow-modified ? #ffffff : (root.light-theme ? #5c6878 : #aeb8c6);
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: lora.custom-tag;
                                                color: root.workflow-modified ? #ffffff : (root.light-theme ? #202833 : #e3e8ef);
                                                width: 90px;
                                                overflow: elide;
                                            }
                                            AppButton {
                                                text: "Edit";
                                                clicked => { root.lora-edit-requested(lora.filename, lora.custom-tag); }
                                            }
                                        }
                                    }
                                    Text { text: "User comments"; color: root.light-theme ? #202833 : #e3e8ef; }
                                    TextEdit {
                                        width: 100%;
                                        vertical-stretch: 1;
                                        text <=> root.user-comments;
                                        wrap: word-wrap;
                                        edited(text) => { root.user-comments-changed(text); }
                                        changed has-focus => { root.text-input-focused = self.has-focus; }
                                    }
                                }
                            }
                            HorizontalLayout {
                                alignment: end;
                                Text {
                                    text: root.workflow-recreated ? "Recreated workflow JSON." : "";
                                    color: root.light-theme ? #687586 : #aeb8c6;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                }
                            }
                            Rectangle {
                                height: 26px;
                                HorizontalLayout {
                                    y: -15px;
                                    alignment: end;
                                    spacing: 5px;
                                    AppButton {
                                        text: root.tree-selection-count > 1
                                            ? "Assign workflow (" + root.tree-selection-count + ")"
                                            : "Assign workflow...";
                                        clicked => { root.assign-workflow-requested(); }
                                    }
                                    AppButton {
                                        text: root.tree-selection-count > 1
                                            ? "Save workflow (" + root.tree-selection-count + ")"
                                            : "Save workflow";
                                        clicked => { root.save-workflow-requested(); }
                                    }
                                    AppButton {
                                        text: "Recreate in ComfyUI";
                                        enabled: root.tree-selection-count <= 1;
                                        clicked => { root.recreate-workflow-requested(); }
                                    }
                                    AppButton {
                                        text: "Open Workflow File";
                                        enabled: root.tree-selection-count <= 1;
                                        clicked => { root.open-workflow-requested(); }
                                    }
                                    AppButton {
                                        text: "Run in ComfyUI";
                                        enabled: root.tree-selection-count <= 1;
                                        clicked => { root.run-workflow-requested(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 80px;
                background: root.light-theme ? #ffffff : #1a2029;
                HorizontalLayout {
                    height: 100%;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 12px;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 20px;
                        background: root.light-theme ? #ffffff : #242d38;
                        border-color: root.light-theme ? (play-area.has-hover ? #b8c0ca : #b8c0ca80) : (play-area.has-hover ? #566171 : #56617180);
                        border-width: 2px;
                        Image {
                            source: root.audio-playing
                                ? @image-url("../assets/icons/pause.svg")
                                : @image-url("../assets/icons/play.svg");
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 18px;
                            height: 18px;
                            colorize: root.light-theme ? #566171 : #f1f4f8;
                            opacity: root.active-audio-path != "" && root.audio-error == "" ? (play-area.has-hover ? 1 : 0.5) : 0.35;
                        }
                        play-area := TouchArea {
                            enabled: root.active-audio-path != "" && root.audio-error == "";
                            clicked => { root.audio-play-pause(); }
                        }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        light-theme: root.light-theme;
                        icon: @image-url("../assets/icons/repeat-2.svg");
                        active: root.loop-mode != 0;
                        Text {
                            visible: root.loop-mode == 1;
                            text: "1";
                            color: #202833;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                        clicked => {
                            root.loop-mode = Math.mod(root.loop-mode + 1, 3);
                            root.loop-changed(root.loop-mode);
                        }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        light-theme: root.light-theme;
                        icon: @image-url("../assets/icons/audio-lines.svg");
                        active: root.auto-play-new-tracks;
                        clicked => {
                            root.auto-play-new-tracks = !root.auto-play-new-tracks;
                            root.auto-play-new-tracks-changed(root.auto-play-new-tracks);
                        }
                    }
                    Text {
                        text: root.audio-current-time + " / " + root.audio-total-duration;
                        color: root.light-theme ? #5c6878 : #aeb8c6;
                        vertical-alignment: center;
                    }
                    Image {
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../assets/icons/volume-2.svg");
                        width: 20px;
                        height: 20px;
                        colorize: root.light-theme ? #566171 : #f1f4f8;
                        vertical-alignment: center;
                    }
                    Slider {
                        value <=> root.audio-volume;
                        minimum: 0;
                        maximum: 1;
                        width: 110px;
                        changed => { root.volume-changed(self.value); }
                    }
                    SyncIconButton {
                        light-theme: root.light-theme;
                        icon: root.comfyui-sync-error-state
                            ? @image-url("../assets/icons/cloud-alert.svg")
                            : root.comfyui-sync-active
                                ? @image-url("../assets/icons/cloud-sync-active.svg")
                                : @image-url("../assets/icons/cloud-sync.svg");
                        tooltip: "ComfyUI sync";
                        status: root.comfyui-sync-status + "  " + root.comfyui-sync-present + "/" + root.comfyui-sync-total;
                        clicked => { root.comfyui-sync-requested(); }
                    }
                    Text {
                        text: root.audio-error;
                        color: #d46b32;
                        vertical-alignment: center;
                        overflow: elide;
                        width: 260px;
                    }
                }
            }

            Rectangle {
                height: 32px;
                background: root.light-theme ? #eef1f5 : #1a2029;
                border-color: root.light-theme ? #cbd2dc : #2a3340;
                border-width: 1px;
                Text {
                    text: !root.has-folder ? "No workspace folder opened" : root.selected-name == "" ? "Workspace: " + root.folder-name : "Workspace: " + root.folder-name + "  —  Selected: " + root.selected-name;
                    color: root.light-theme ? #5c6878 : #7f8b9d;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    padding-right: 12px;
                    spacing: 6px;
                    Rectangle { horizontal-stretch: 1; }
                    if root.audio-loading : Text {
                        text: root.audio-spinner;
                        color: root.light-theme ? #d46b32 : #e58a4d;
                        font-size: 16px;
                    }
                    Text {
                        text: root.audio-loading ? "Waveforms " + root.audio-completed + "/" + root.audio-total : "";
                        color: root.light-theme ? #5c6878 : #7f8b9d;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    if root.comfyui-sync-active || root.comfyui-sync-error-state : Rectangle {
                        width: sync-status-text.preferred-width + (root.comfyui-sync-active ? 22px : 8px);
                        height: 28px;
                        background: transparent;
                        if root.comfyui-sync-active : Text {
                            text: root.comfyui-sync-spinner;
                            x: 4px;
                            width: 14px;
                            color: root.light-theme ? #d46b32 : #e58a4d;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        sync-status-text := Text {
                            x: root.comfyui-sync-active ? 20px : 4px;
                            text: root.comfyui-sync-error-state
                                ? "Syncing error..."
                                : "Syncing " + root.comfyui-sync-present + "/" + root.comfyui-sync-total;
                            color: root.comfyui-sync-error-state
                                ? #d46b32
                                : (root.light-theme ? #5c6878 : #7f8b9d);
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.comfyui-sync-requested(); } }
                    }
                    CompactIconButton {
                        icon: @image-url("../assets/icons/file-code-2.svg");
                        active: root.metadata-visible;
                        clicked => { root.metadata-toggle(); }
                    }
                }
            }
        }

        if root.file-menu-visible : Rectangle {
            x: 0px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "Open Folder...";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.file-menu-visible = false;
                    root.open-folder();
                }
            }
        }

        if root.edit-menu-visible : Rectangle {
            x: 70px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "Settings";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.edit-menu-visible = false;
                    root.settings-visible = true;
                }
            }
        }

        if root.view-menu-visible : Rectangle {
            x: 140px;
            y: 40px;
            width: 210px;
            height: 84px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Rectangle {
                width: 100%;
                height: 100%;
                background: fullscreen-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "Toggle full screen";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    width: parent.width - 70px;
                    vertical-alignment: center;
                }
                Text {
                    text: "F11";
                    color: root.light-theme ? #5c6878 : #aeb8c6;
                    x: parent.width - 56px;
                    width: 42px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                fullscreen-touch := TouchArea {
                    clicked => {
                        root.view-menu-visible = false;
                        root.toggle-fullscreen();
                    }
                }
            }
            Rectangle {
                y: 42px;
                width: 100%;
                height: 1px;
                background: root.light-theme ? #cbd2dc : #435064;
            }
            Rectangle {
                y: 43px;
                width: 100%;
                height: 41px;
                background: metadata-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "Toggle metadata";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    width: parent.width - 70px;
                    vertical-alignment: center;
                }
                Text {
                    text: "F9";
                    color: root.light-theme ? #5c6878 : #aeb8c6;
                    x: parent.width - 56px;
                    width: 42px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                metadata-touch := TouchArea {
                    clicked => {
                        root.view-menu-visible = false;
                        root.metadata-toggle();
                    }
                }
            }
        }

        if root.help-menu-visible : Rectangle {
            x: 210px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "About";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.help-menu-visible = false;
                    root.about-visible = true;
                }
            }
        }

        if root.tree-menu-visible : Rectangle {
            x: (root.tree-menu-x + 6px).min(parent.width - self.width).max(0px);
            y: (root.tree-menu-y + 6px).min(parent.height - self.height).max(0px);
            width: 210px;
            height: 155px;
            z: 1000;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 31px;
                background: reveal-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "Show in folder...";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    y: 0px;
                    width: 196px;
                    height: 31px;
                    vertical-alignment: center;
                }
                reveal-touch := TouchArea {
                    width: 100%;
                    height: 31px;
                    clicked => {
                        root.tree-menu-visible = false;
                        root.tree-reveal-requested(root.tree-menu-path);
                    }
                }
            }
            Rectangle {
                x: 0px;
                y: 31px;
                width: 100%;
                height: 31px;
                background: rename-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "Rename...  F2";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    y: 0px;
                    width: 196px;
                    height: 31px;
                    vertical-alignment: center;
                }
                rename-touch := TouchArea {
                    width: 100%;
                    height: 31px;
                    clicked => {
                        root.tree-menu-visible = false;
                        root.rename-requested();
                    }
                }
            }
            Rectangle {
                x: 0px;
                y: 62px;
                width: 100%;
                height: 31px;
                background: folder-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "New Folder";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    y: 0px;
                    width: 196px;
                    height: 31px;
                    vertical-alignment: center;
                }
                folder-touch := TouchArea {
                    width: 100%;
                    height: 31px;
                    clicked => {
                        root.tree-menu-visible = false;
                        root.new-folder-requested(root.tree-menu-path);
                    }
                }
            }
            Rectangle {
                x: 0px;
                y: 93px;
                width: 100%;
                height: 31px;
                background: convert-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "Convert to file format...";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    y: 0px;
                    width: 196px;
                    height: 31px;
                    vertical-alignment: center;
                }
                convert-touch := TouchArea {
                    width: 100%;
                    height: 31px;
                    clicked => {
                        root.tree-menu-visible = false;
                        root.conversion-requested(root.tree-menu-path);
                    }
                }
            }
            Rectangle {
                x: 0px;
                y: 124px;
                width: 100%;
                height: 31px;
                background: trash-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "Move to Trash";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    y: 0px;
                    width: 196px;
                    height: 31px;
                    vertical-alignment: center;
                }
                trash-touch := TouchArea {
                    width: 100%;
                    height: 31px;
                    clicked => {
                        root.tree-menu-visible = false;
                        root.tree-trash-requested(root.tree-menu-path);
                    }
                }
            }
        }

        if root.conversion-options-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            z: 30;
            Rectangle {
                width: 460px;
                height: 270px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;
                VerticalBox {
                    padding: 24px;
                    spacing: 14px;
                    Text { text: "Convert to file format"; color: root.light-theme ? #202833 : #f1f4f8; font-size: 21px; }
                    Text { text: "Format"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                    ComboBox {
                        model: ["mp3", "ogg", "opus", "flac", "wav"];
                        current-index: root.conversion-format-index;
                        changed has-focus => { root.text-input-focused = self.has-focus; }
                        changed current-index => { root.conversion-format-index = self.current-index; }
                    }
                    Text { text: "Quality"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                    ComboBox {
                        model: root.conversion-quality-labels;
                        current-index: root.conversion-quality-index;
                        changed has-focus => { root.text-input-focused = self.has-focus; }
                        changed current-index => { root.conversion-quality-index = self.current-index; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        AppButton { text: "Cancel"; clicked => { root.conversion-options-visible = false; } }
                        AppButton {
                            text: "Start conversion...";
                            clicked => {
                                root.conversion-options-visible = false;
                                root.conversion-started(
                                    ["mp3", "ogg", "opus", "flac", "wav"][root.conversion-format-index],
                                    root.conversion-quality-values[root.conversion-quality-index]
                                );
                            }
                        }
                    }
                }
            }
        }

        if root.conversion-progress-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            z: 31;
            Rectangle {
                width: 700px;
                height: 520px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;
                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text { text: "Converting audio"; color: root.light-theme ? #202833 : #f1f4f8; font-size: 21px; }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.conversion-rows : VerticalBox {
                            height: 54px;
                            spacing: 4px;
                            Text { text: row.name; color: root.light-theme ? #202833 : #f1f4f8; overflow: elide; }
                            HorizontalLayout {
                                height: 18px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: root.light-theme ? #e1e6ed : #303b4b;
                                    Rectangle { width: parent.width * row.progress; background: root.light-theme ? #d46b32 : #e58a4d; }
                                }
                                Text { text: row.status; width: 180px; color: root.light-theme ? #5c6878 : #aeb8c6; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        AppButton { text: "Cancel"; enabled: !root.conversion-complete; clicked => { root.conversion-cancelled(); } }
                        AppButton { text: "Close"; enabled: root.conversion-complete; clicked => { root.conversion-closed(); } }
                    }
                }
            }
        }

        if root.comfyui-run-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            z: 32;
            Rectangle {
                width: 560px;
                height: 230px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;
                VerticalBox {
                    padding: 24px;
                    spacing: 14px;
                    Text { text: "Running workflow in ComfyUI"; color: root.light-theme ? #202833 : #f1f4f8; font-size: 21px; }
                    Rectangle {
                        height: 18px;
                        background: root.light-theme ? #e1e6ed : #303b4b;
                        Rectangle { width: parent.width * root.comfyui-run-progress; background: root.light-theme ? #d46b32 : #e58a4d; }
                    }
                    Text { text: root.comfyui-run-step; color: root.light-theme ? #5c6878 : #aeb8c6; overflow: elide; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        AppButton { text: "Cancel"; enabled: !root.comfyui-run-cancel-requested && !root.comfyui-run-complete; clicked => { root.run-workflow-cancelled(); } }
                        AppButton { text: "Close"; enabled: root.comfyui-run-complete; clicked => { root.run-workflow-closed(); } }
                    }
                }
            }
        }

        if root.about-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            Rectangle {
                width: 390px;
                height: 250px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #202832;
                border-color: #435064;
                border-width: 1px;

                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text {
                        text: "About Adb Studio";
                        color: #f1f4f8;
                        font-size: 22px;
                    }
                    Text { text: "Version 0.1.0"; color: #c4ccd8; }
                    Text { text: "Build: " + root.build-number; color: #c4ccd8; }
                    Text { text: "Author: Alexandre Dupuis-Belin"; color: #c4ccd8; }
                    Rectangle { vertical-stretch: 1; }
                    AppButton {
                        text: "Close";
                        clicked => { root.close-about(); }
                    }
                }
            }
        }

        if root.settings-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            Rectangle {
                width: 760px;
                height: 560px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;

                HorizontalLayout {
                    Rectangle {
                        width: 170px;
                        background: root.light-theme ? #eef1f5 : #171c24;
                        VerticalBox {
                            padding: 20px;
                            spacing: 12px;
                            Text {
                                text: "Settings";
                                color: root.light-theme ? #202833 : #f1f4f8;
                                font-size: 22px;
                            }
                            Rectangle {
                                height: 38px;
                                background: root.light-theme ? #d7e3f3 : #2a3546;
                                border-color: root.light-theme ? #8ea9c6 : #5d7898;
                                border-width: 1px;
                                Text {
                                    text: "Look Feel";
                                    x: 12px;
                                    color: root.light-theme ? #202833 : #f1f4f8;
                                    vertical-alignment: center;
                                }
                                TouchArea { clicked => { root.settings-tab = 0; } }
                            }
                            Rectangle {
                                height: 38px;
                                background: root.settings-tab == 1 ? (root.light-theme ? #d7e3f3 : #2a3546) : transparent;
                                border-color: root.settings-tab == 1 ? (root.light-theme ? #8ea9c6 : #5d7898) : transparent;
                                border-width: 1px;
                                Text {
                                    text: "Keyboard shortcuts";
                                    x: 12px;
                                    color: root.light-theme ? #202833 : #f1f4f8;
                                    vertical-alignment: center;
                                }
                                TouchArea { clicked => { root.settings-tab = 1; } }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        if root.settings-tab == 0 : VerticalBox {
                            padding: 24px;
                            spacing: 14px;
                            Text {
                                text: "Look Feel";
                                color: root.light-theme ? #202833 : #f1f4f8;
                                font-size: 22px;
                            }
                            Text {
                                text: "Theme";
                                color: root.light-theme ? #5c6878 : #c4ccd8;
                            }
                            ComboBox {
                                model: ["Dark theme", "Light theme"];
                                current-index: root.theme-index;
                                changed has-focus => { root.text-input-focused = self.has-focus; }
                                changed current-index => { root.theme-selected(self.current-index == 1); }
                            }
                            CheckBox {
                                text: "Don't show tips of the day anymore";
                                checked: root.hide-tips-of-the-day;
                                toggled => { root.tips-preference-changed(self.checked); }
                            }
                            Text {
                                text: "Comment bubbles";
                                color: root.light-theme ? #5c6878 : #c4ccd8;
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "Background"; width: 100px; color: root.light-theme ? #202833 : #e3e8ef; vertical-alignment: center; }
                                Rectangle {
                                    width: 42px;
                                    height: 28px;
                                    background: root.comment-background-color;
                                    border-color: root.comment-text-color;
                                    border-width: 1px;
                                    TouchArea {
                                        clicked => {
                                            root.color-picker-target = 0;
                                            root.color-picker-value = root.comment-background-hex;
                                            root.color-picker-visible = true;
                                        }
                                    }
                                }
                                Text { text: root.comment-background-hex; color: root.light-theme ? #5c6878 : #aeb8c6; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "Text"; width: 100px; color: root.light-theme ? #202833 : #e3e8ef; vertical-alignment: center; }
                                Rectangle {
                                    width: 42px;
                                    height: 28px;
                                    background: root.comment-text-color;
                                    border-color: root.comment-background-color;
                                    border-width: 1px;
                                    TouchArea {
                                        clicked => {
                                            root.color-picker-target = 1;
                                            root.color-picker-value = root.comment-text-hex;
                                            root.color-picker-visible = true;
                                        }
                                    }
                                }
                                Text { text: root.comment-text-hex; color: root.light-theme ? #5c6878 : #aeb8c6; vertical-alignment: center; }
                            }
                            Rectangle { vertical-stretch: 1; }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                AppButton { text: "Close"; clicked => { root.close-settings(); } }
                            }
                        }
                        if root.settings-tab == 1 : VerticalBox {
                            padding: 24px;
                            spacing: 14px;
                            Text {
                                text: "Keyboard shortcuts";
                                color: root.light-theme ? #202833 : #f1f4f8;
                                font-size: 22px;
                            }
                            Text { text: "Playback"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "Seek step"; width: 130px; color: root.light-theme ? #202833 : #e3e8ef; vertical-alignment: center; }
                                ComboBox {
                                    model: ["1 second", "2 seconds", "3 seconds", "4 seconds", "5 seconds", "10 seconds", "15 seconds", "30 seconds"];
                                    current-index: root.seek-seconds == 1 ? 0 : root.seek-seconds == 2 ? 1 : root.seek-seconds == 3 ? 2 : root.seek-seconds == 4 ? 3 : root.seek-seconds == 10 ? 5 : root.seek-seconds == 15 ? 6 : root.seek-seconds == 30 ? 7 : 4;
                                    changed has-focus => { root.text-input-focused = self.has-focus; }
                                    changed current-index => { root.seek-seconds-changed(self.current-index == 0 ? 1 : self.current-index == 1 ? 2 : self.current-index == 2 ? 3 : self.current-index == 3 ? 4 : self.current-index == 5 ? 10 : self.current-index == 6 ? 15 : self.current-index == 7 ? 30 : 5); }
                                }
                            }
                            Text { text: "Keys"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                            VerticalBox {
                                spacing: 5px;
                                property <[string]> shortcut-keys: ["F11", "F9", "Space", "Up", "Down", "Escape", "F2", "Left", "Right", "Delete"];
                                HorizontalLayout { Text { text: "Fullscreen"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-fullscreen; changed has-focus => { root.text-input-focused = self.has-focus; } changed current-index => { root.shortcut-changed(0, self.current-index); } } }
                                HorizontalLayout { Text { text: "Metadata pane"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-metadata; changed has-focus => { root.text-input-focused = self.has-focus; } changed current-index => { root.shortcut-changed(1, self.current-index); } } }
                                HorizontalLayout { Text { text: "Play / pause"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-play-pause; changed has-focus => { root.text-input-focused = self.has-focus; } changed current-index => { root.shortcut-changed(2, self.current-index); } } }
                                HorizontalLayout { Text { text: "Previous track"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-navigate-up; changed has-focus => { root.text-input-focused = self.has-focus; } changed current-index => { root.shortcut-changed(3, self.current-index); } } }
                                HorizontalLayout { Text { text: "Next track"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-navigate-down; changed has-focus => { root.text-input-focused = self.has-focus; } changed current-index => { root.shortcut-changed(4, self.current-index); } } }
                                HorizontalLayout { Text { text: "Cancel edit"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-cancel-edit; changed has-focus => { root.text-input-focused = self.has-focus; } changed current-index => { root.shortcut-changed(5, self.current-index); } } }
                                HorizontalLayout { Text { text: "Seek backward"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-seek-backward; changed has-focus => { root.text-input-focused = self.has-focus; } changed current-index => { root.shortcut-changed(6, self.current-index); } } }
                                HorizontalLayout { Text { text: "Seek forward"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-seek-forward; changed has-focus => { root.text-input-focused = self.has-focus; } changed current-index => { root.shortcut-changed(7, self.current-index); } } }
                                HorizontalLayout { Text { text: "Move to trash"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-trash; changed has-focus => { root.text-input-focused = self.has-focus; } changed current-index => { root.shortcut-changed(8, self.current-index); } } }
                            }
                            Rectangle { vertical-stretch: 1; }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                AppButton { text: "Close"; clicked => { root.close-settings(); } }
                            }
                        }
                    }
                }
            }
        }

