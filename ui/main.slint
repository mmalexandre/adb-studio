import { CheckBox, ComboBox, LineEdit, ListView, ScrollView, Slider, SpinBox, TextEdit, VerticalBox } from "std-widgets.slint";
import { AudioRow, BreadcrumbRow, CommentRow, ConversionRow, TreeRow, WorkflowFileRow, WorkflowLoraRow } from "./models.slint";
import { WorkflowSuggestionBox } from "./workflow_suggestion.slint";
import { AppButton, CompactIconButton, IconButton, MenuButton, SortIconButton, SyncIconButton, ToolButton } from "./controls.slint";

component Waveform inherits Rectangle {
    height: 58px;
    background: transparent;
    in property <bool> light-theme;
    in property <color> comment-background-color: #000000;
    in property <color> comment-text-color: #ffffff;
    in property <bool> is-active;
    in property <[float]> peaks;
    in property <bool> is-loading;
    in property <[CommentRow]> comments: [];
    in property <float> selected-comment-start: -1;
    in property <float> selected-comment-end: -1;
    property <int> hovered-comment: -1;
    property <float> gesture-start: -1;
    property <float> gesture-end: -1;
    property <float> comment-drag-start: -1;
    property <float> comment-drag-original-start: -1;
    property <float> comment-drag-original-end: -1;
    property <int> comment-drag-index: -1;
    property <float> comment-drag-preview-start: -1;
    property <bool> comment-dragged: false;
    in property <float> progress: 0;
    callback seek-requested(float);
    callback comment-range-requested(float, float);
    callback comment-selected(float, float, string);
    callback comment-edit-requested(float, float, string);
    callback comment-range-moved(float, float, float, float, string);

    function displayed-comment-start(index: int, start: float) -> float {
        return index == root.comment-drag-index ? root.comment-drag-preview-start : start;
    }

    VerticalBox {
        spacing: 0px;
        Rectangle {
            height: 29px;
            HorizontalLayout {
                spacing: 2px;
                for peak[index] in root.peaks : Rectangle {
                    width: (parent.width - (root.peaks.length - 1) * 2px) / root.peaks.length;
                    height: 29px;
                    Rectangle {
                        width: 100%;
                        height: 2px + peak * 25px;
                        border-radius: 1px;
                        y: parent.height - self.height;
                        background: (index / root.peaks.length) <= root.progress ? (root.light-theme ? #d46b32 : #e58a4d) : (root.light-theme ? #b8c0ca : #566171);
                    }
                }
            }
        }
        Rectangle {
            height: 29px;
            HorizontalLayout {
                spacing: 2px;
                for peak[index] in root.peaks : Rectangle {
                    width: (parent.width - (root.peaks.length - 1) * 2px) / root.peaks.length;
                    height: 29px;
                    Rectangle {
                        width: 100%;
                        height: 2px + peak * 25px;
                        border-radius: 1px;
                        y: 0px;
                        opacity: 0.5;
                        background: (index / root.peaks.length) <= root.progress ? (root.light-theme ? #d46b32 : #e58a4d) : (root.light-theme ? #b8c0ca : #566171);
                    }
                }
            }
        }
    }
    Rectangle {
        x: root.progress * (parent.width - 1px);
        y: 0px;
        width: 1px;
        height: parent.height;
        background: #ffffff;
        visible: root.is-active && root.peaks.length > 0;
    }
    if root.is-loading : Rectangle {
        x: (parent.width - 24px) / 2;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        background: root.light-theme ? #ffffffd9 : #1a2029d9;
        border-radius: 12px;
        Image {
            source: @image-url("../assets/icons/refresh-cw.svg");
            x: 4px;
            y: 4px;
            width: 16px;
            height: 16px;
            colorize: root.light-theme ? #d46b32 : #e58a4d;
            transform-rotation: root.is-loading ? 360deg : 0deg;
            animate transform-rotation {
                duration: 900ms;
                iteration-count: 1000000;
            }
        }
    }
    if root.selected-comment-start >= 0 && root.selected-comment-end >= root.selected-comment-start : Rectangle {
        x: root.selected-comment-start * parent.width;
        width: (root.selected-comment-end - root.selected-comment-start) * parent.width;
        y: 0px;
        height: parent.height;
        background: root.light-theme ? #d46b3240 : #e58a4d40;
        border-color: root.light-theme ? #d46b32 : #e58a4d;
        border-width: 1px;
    }
    if root.selected-comment-start >= 0 : Rectangle {
        x: root.selected-comment-start * parent.width;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: #11151b;
        Text { text: "▼"; x: -5px; y: -2px; color: #11151b; font-size: 10px; }
    }
    if root.selected-comment-end > root.selected-comment-start : Rectangle {
        x: root.selected-comment-end * parent.width;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: #11151b;
        Text { text: "▼"; x: -5px; y: -2px; color: #11151b; font-size: 10px; }
    }
    if root.hovered-comment >= 0 && root.comments[root.hovered-comment].end >= root.comments[root.hovered-comment].start : Rectangle {
        x: root.comments[root.hovered-comment].start * parent.width;
        width: (root.comments[root.hovered-comment].end - root.comments[root.hovered-comment].start) * parent.width;
        y: 0px;
        height: parent.height;
        background: root.light-theme ? #d46b3260 : #e58a4d60;
        border-color: root.light-theme ? #d46b32 : #e58a4d;
        border-width: 1px;
    }
    if root.hovered-comment >= 0 : Rectangle {
        x: root.comments[root.hovered-comment].start * parent.width;
        y: 0px;
        width: 2px;
        height: parent.height;
        background: #11151b;
        Text { text: "▼"; x: -5px; y: 0px; color: #11151b; font-size: 10px; }
    }
    if root.hovered-comment >= 0 && root.comments[root.hovered-comment].end > root.comments[root.hovered-comment].start : Rectangle {
        x: root.comments[root.hovered-comment].end * parent.width;
        y: 0px;
        width: 2px;
        height: parent.height;
        background: #11151b;
        Text { text: "▼"; x: -5px; y: 0px; color: #11151b; font-size: 10px; }
    }
    if root.gesture-start >= 0 && root.gesture-end >= root.gesture-start : Rectangle {
        x: root.gesture-start * parent.width;
        width: (root.gesture-end - root.gesture-start) * parent.width;
        y: 0px;
        height: parent.height;
        background: root.light-theme ? #d46b3260 : #e58a4d60;
        border-color: root.light-theme ? #d46b32 : #e58a4d;
        border-width: 1px;
    }
    if root.gesture-start >= 0 : Rectangle {
        x: root.gesture-start * parent.width;
        y: 0px;
        width: 2px;
        height: parent.height;
        background: #11151b;
        Text { text: "▼"; x: -5px; y: 0px; color: #11151b; font-size: 10px; }
    }
    if root.gesture-end > root.gesture-start : Rectangle {
        x: root.gesture-end * parent.width;
        y: 0px;
        width: 2px;
        height: parent.height;
        background: #11151b;
        Text { text: "▼"; x: -5px; y: 0px; color: #11151b; font-size: 10px; }
    }
    TouchArea {
        clicked => { root.seek-requested((self.mouse-x / self.width).max(0).min(1)); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.gesture-start = (self.mouse-x / self.width).max(0).min(1);
                root.gesture-end = root.gesture-start;
            } else if event.kind == PointerEventKind.move && root.gesture-start >= 0 {
                root.gesture-end = (self.mouse-x / self.width).max(0).min(1);
            } else if event.kind == PointerEventKind.up && root.gesture-start >= 0 {
                root.comment-range-requested(
                    root.gesture-start.min(root.gesture-end),
                    root.gesture-start.max(root.gesture-end)
                );
                root.gesture-start = -1;
                root.gesture-end = -1;
            }
        }
    }
    for comment[index] in root.comments : comment-container := Rectangle {
        x: root.displayed-comment-start(index, comment.start) * parent.width;
        height: parent.height;
        width: ((comment.bubble-end - comment.start) * parent.width).max(comment-text.preferred-width + 8px).min(root.width * (1 - comment.start));
        background: transparent;
        Rectangle {
            x: 1px;
            y: 39px;
            width: comment-touch.has-hover ? (comment-text.preferred-width + 8px).min(root.width * (1 - comment.start) - 2px).max(parent.width - 2px).max(8px) : (comment-text.preferred-width + 8px).min(parent.width - 2px).max(8px);
            height: 17px;
            visible: !comment-touch.has-hover;
            background: root.comment-background-color;
            border-color: root.comment-text-color;
            border-width: 1px;
            comment-text := Text {
                text: comment.text;
                x: 4px;
                width: parent.width - 8px;
                color: root.comment-text-color;
                font-size: 10px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        comment-hit := Rectangle {
            x: 1px;
            y: 39px;
            width: comment-touch.has-hover ? (comment-text.preferred-width + 8px).min(root.width * (1 - comment.start) - 2px).max(8px) : (comment-text.preferred-width + 8px).min(parent.width - 2px).max(8px);
            height: 17px;
            background: transparent;
            comment-touch := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.comment-edit-requested(comment.start, comment.end, comment.text);
                    } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.comment-drag-start = ((self.mouse-x + comment-hit.x + comment-container.x) / root.width).max(0).min(1);
                        root.comment-drag-original-start = comment.start;
                        root.comment-drag-original-end = comment.end;
                        root.comment-drag-index = index;
                        root.comment-drag-preview-start = comment.start;
                        root.comment-dragged = false;
                    } else if event.kind == PointerEventKind.move && root.comment-drag-start >= 0 {
                        let pointer = ((self.mouse-x + comment-hit.x + comment-container.x) / root.width).max(0).min(1);
                        let delta = pointer - root.comment-drag-start;
                        let length = root.comment-drag-original-end - root.comment-drag-original-start;
                        root.comment-drag-preview-start = (root.comment-drag-original-start + delta).max(0).min(1 - length);
                        root.comment-dragged = root.comment-dragged || delta.abs() > 0.005;
                    } else if event.kind == PointerEventKind.up && root.comment-drag-start >= 0 {
                        let pointer = ((self.mouse-x + comment-hit.x + comment-container.x) / root.width).max(0).min(1);
                        let delta = pointer - root.comment-drag-start;
                        if root.comment-dragged {
                            let length = root.comment-drag-original-end - root.comment-drag-original-start;
                            let start = (root.comment-drag-original-start + delta).max(0).min(1 - length);
                            root.comment-range-moved(root.comment-drag-original-start, root.comment-drag-original-end, start, start + length, comment.text);
                        } else {
                            root.comment-selected(comment.start, comment.end, comment.text);
                        }
                        root.comment-drag-start = -1;
                        root.comment-drag-index = -1;
                        root.comment-drag-preview-start = -1;
                        root.comment-dragged = false;
                    }
                }
                changed has-hover => {
                    if self.has-hover {
                        root.hovered-comment = index;
                    } else if root.hovered-comment == index {
                        root.hovered-comment = -1;
                    }
                }
            }
        }
    }
    if root.hovered-comment >= 0 : Rectangle {
        x: root.displayed-comment-start(root.hovered-comment, root.comments[root.hovered-comment].start) * parent.width;
        y: 39px;
        width: (hovered-label.preferred-width + 8px).min(parent.width - self.x - 2px).max(8px);
        height: 17px;
        z: 10;
        background: root.comment-background-color;
        border-color: root.comment-text-color;
        border-width: 1px;
        hovered-label := Text {
            text: root.comments[root.hovered-comment].text;
            x: 4px;
            width: parent.width - 8px;
            color: root.comment-text-color;
            font-size: 10px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

component AudioRowView inherits Rectangle {
    height: 86px;
    background: root.light-theme ? #ffffff : #1a2029;
    border-color: root.is-selected ? #000000 : root.is-active ? (root.light-theme ? #d46b32 : #e58a4d) : (root.light-theme ? #d9dee6 : #2a3340);
    border-width: 1px;
    in property <bool> light-theme;
    in property <color> comment-background-color: #000000;
    in property <color> comment-text-color: #ffffff;
    in property <string> name;
    in property <string> modified-date;
    in property <[float]> peaks;
    in property <bool> is-loading;
    in property <[CommentRow]> comments;
    in property <int> rating: 0;
    property <int> hovered-rating: -1;
    in property <bool> is-selected;
    in property <bool> is-active;
    in property <bool> is-playing;
    in property <float> progress;
    in property <bool> loop-enabled;
    in property <float> selected-comment-start: -1;
    in property <float> selected-comment-end: -1;
    callback play-requested();
    callback seek-requested(float);
    callback comment-range-requested(float, float);
    callback comment-selected(float, float, string);
    callback comment-edit-requested(float, float, string);
    callback comment-range-moved(float, float, float, float, string);
    callback rating-requested(int);
    callback trash-requested();

    VerticalBox {
        padding: 8px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 2px;
        HorizontalLayout {
            height: 40px;
            spacing: 8px;
            Text {
                text: root.name;
                color: root.light-theme ? #202833 : #e3e8ef;
                font-size: 14px;
                overflow: elide;
                horizontal-stretch: 1;
            }
            HorizontalLayout {
                width: 156px;
                y: 20px;
                spacing: 0px;
                alignment: center;
                for star-index in 5 : Rectangle {
                    width: 24px;
                    height: 32px;
                    Image {
                        source: star-index < (root.hovered-rating >= 0 ? root.hovered-rating : root.rating)
                            ? @image-url("../assets/icons/star-filled.svg")
                            : @image-url("../assets/icons/star.svg");
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 20px;
                        height: 20px;
                    }
                    TouchArea {
                        clicked => { root.rating-requested(star-index + 1); }
                        changed has-hover => { root.hovered-rating = self.has-hover ? star-index + 1 : -1; }
                    }
                }
                Rectangle {
                    width: 24px;
                    height: 32px;
                    Image {
                        source: @image-url("../assets/icons/x.svg");
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 16px;
                        height: 16px;
                    }
                    TouchArea {
                        clicked => { root.rating-requested(0); }
                        changed has-hover => { root.hovered-rating = self.has-hover ? 0 : -1; }
                    }
                }
            }
            Rectangle {
                width: 40px;
                height: 40px;
                y: 12px;
                background: transparent;
                Image {
                    source: @image-url("../assets/icons/trash-2.svg");
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 18px;
                    height: 18px;
                    opacity: trash-area.has-hover ? 1 : 0.65;
                }
                trash-area := TouchArea {
                    clicked => { root.trash-requested(); }
                }
            }
            Rectangle {
                width: 40px;
                height: 40px;
                VerticalBox {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: #ffffff;
                        border-color: root.light-theme ? (play-area.has-hover ? #b8c0ca : #b8c0ca80) : (play-area.has-hover ? #566171 : #56617180);
                        border-width: 2px;
                        Image {
                            source: root.is-playing
                                ? @image-url("../assets/icons/pause.svg")
                                : @image-url("../assets/icons/play.svg");
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 18px;
                            height: 18px;
                            opacity: play-area.has-hover ? 1 : 0.5;
                        }
                        play-area := TouchArea {
                            clicked => { root.play-requested(); }
                        }
                    }
                    Rectangle { width: 25px; }
                }
            }
        }
        HorizontalLayout {
            height: 58px;
            Waveform {
                width: parent.width - 244px;
                light-theme: root.light-theme;
                comment-background-color: root.comment-background-color;
                comment-text-color: root.comment-text-color;
                is-active: root.is-active;
                is-loading: root.is-loading;
                peaks: root.peaks;
                comments: root.comments;
                selected-comment-start: root.selected-comment-start;
                selected-comment-end: root.selected-comment-end;
                progress: root.progress;
                y: -40px;
                seek-requested(progress) => { root.seek-requested(progress); }
                comment-range-requested(start, end) => { root.comment-range-requested(start, end); }
                comment-selected(start, end, text) => { root.comment-selected(start, end, text); }
                comment-edit-requested(start, end, text) => { root.comment-edit-requested(start, end, text); }
                comment-range-moved(old-start, old-end, start, end, text) => { root.comment-range-moved(old-start, old-end, start, end, text); }
            }
            Rectangle { width: 244px; }
        }
    }
}

component AudioList inherits ListView {
    in property <bool> light-theme;
    in property <color> comment-background-color: #000000;
    in property <color> comment-text-color: #ffffff;
    in property <[AudioRow]> rows;
    in property <int> scroll-to-index: -1;
    callback row-selected(string);
    callback viewport-changed(int, int);
    callback seek-requested(string, float);
    callback play-requested(string);
    callback comment-range-requested(string, float, float);
    callback comment-selected(string, float, float, string);
    callback comment-edit-requested(string, float, float, string);
    callback comment-range-moved(string, float, float, float, float, string);
    callback rating-requested(string, int);
    callback trash-requested(string);

    changed viewport-y => {
        root.viewport-changed(
            (0px - root.viewport-y) / 86px,
            (root.height / 86px) + 1
        );
    }

    changed scroll-to-index => {
        if root.scroll-to-index >= 0 {
            root.viewport-y = 0px - root.scroll-to-index * 86px;
        }
    }

    for row in root.rows : AudioRowView {
        light-theme: root.light-theme;
        comment-background-color: root.comment-background-color;
        comment-text-color: root.comment-text-color;
        name: row.name;
        modified-date: row.modified-date;
        peaks: row.peaks;
        comments: row.comments;
        rating: row.rating;
        is-selected: row.is-selected;
        is-active: row.is-active;
        is-playing: row.is-playing;
        progress: row.progress;
        is-loading: row.is-loading;
        loop-enabled: row.loop-enabled;
        selected-comment-start: row.selected-comment-start;
        selected-comment-end: row.selected-comment-end;
        seek-requested(progress) => { root.row-selected(row.path); root.seek-requested(row.path, progress); }
        play-requested => { root.row-selected(row.path); root.play-requested(row.path); }
        comment-range-requested(start, end) => { root.row-selected(row.path); root.comment-range-requested(row.path, start, end); }
        comment-selected(start, end, text) => { root.row-selected(row.path); root.comment-selected(row.path, start, end, text); }
        comment-edit-requested(start, end, text) => { root.row-selected(row.path); root.comment-edit-requested(row.path, start, end, text); }
        comment-range-moved(old-start, old-end, start, end, text) => { root.row-selected(row.path); root.comment-range-moved(row.path, old-start, old-end, start, end, text); }
        rating-requested(rating) => { root.row-selected(row.path); root.rating-requested(row.path, rating); }
        trash-requested => { root.trash-requested(row.path); }
    }
}

component ExplorerRow inherits Rectangle {
    width: 100%;
    height: 26px;
    background: root.is-selected ? (root.light-theme ? #d7e3f3 : #2a3546) : transparent;
    callback clicked(bool);
    callback right-clicked(length, length);
    callback drag-finished(bool, float);
    callback edit-accepted(string);
    callback edit-cancelled();
    in property <bool> light-theme;
    in property <string> path;
    in property <string> name;
    in property <int> depth;
    in property <bool> is-dir;
    in property <bool> is-expanded;
    in property <bool> is-selected;
    in property <string> kind;
    in property <int> drag-count: 1;
    in property <bool> editing;
    in-out property <string> edit-text: "";
    property <bool> dragging: false;
    property <bool> dragged: false;
    property <length> drag-start-y: 0px;
    property <length> drag-pointer-x: 0px;
    property <length> drag-pointer-y: 0px;
    property <bool> click-shift: false;

    function icon-source() -> image {
        if root.kind == "dir" && root.is-expanded {
            return @image-url("../assets/icons/folder-open.svg");
        }
        if root.kind == "dir" {
            return @image-url("../assets/icons/folder.svg");
        }
        if root.kind == "audio" {
            return @image-url("../assets/icons/file-audio.svg");
        }
        if root.kind == "safetensors" {
            return @image-url("../assets/icons/file-code-2.svg");
        }
        if root.kind == "json" {
            return @image-url("../assets/icons/file-json.svg");
        }
        return @image-url("../assets/icons/file.svg");
    }

    HorizontalLayout {
        padding-left: 8px + root.depth * 16px;
        padding-right: 8px;
        spacing: 6px;
        if root.kind == "dir" : Image {
            source: @image-url("../assets/icons/chevron-right.svg");
            width: 20px;
            height: 20px;
            transform-rotation: root.is-expanded ? 90deg : 0deg;
            animate transform-rotation {
                duration: 200ms;
                easing: ease-in-out;
            }
            vertical-alignment: center;
        }
        if root.kind != "dir" : Rectangle {
            width: 20px;
            height: 20px;
        }
        Image {
            source: root.icon-source();
            width: 16px;
            height: 16px;
            vertical-alignment: center;
        }
        if root.editing : LineEdit {
            text <=> root.edit-text;
            horizontal-stretch: 1;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.edit-cancelled();
                    accept;
                }
                reject;
            }
            changed has-focus => {
                if !self.has-focus {
                    root.edit-cancelled();
                }
            }
            accepted(text) => { root.edit-accepted(text); }
        }
        if !root.editing : Text {
            text: root.name;
            color: root.light-theme ? #202833 : #e3e8ef;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if !root.editing : TouchArea {
        clicked => {
            if !root.dragged {
                root.clicked(root.click-shift);
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.right-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.click-shift = event.modifiers.shift;
                root.dragging = true;
                root.dragged = false;
                root.drag-start-y = self.mouse-y;
            } else if event.kind == PointerEventKind.move && root.dragging {
                root.drag-pointer-x = self.mouse-x;
                root.drag-pointer-y = self.mouse-y;
                if (self.mouse-y - root.drag-start-y).abs() > 4px {
                    root.dragged = true;
                }
            } else if event.kind == PointerEventKind.up && root.dragging {
                root.drag-finished(root.dragged, self.mouse-y / 1px);
                root.dragging = false;
            }
        }
    }
    if root.dragging && root.dragged : Rectangle {
        x: root.drag-pointer-x + 8px;
        y: root.drag-pointer-y + 8px;
        width: 30px;
        height: 30px;
        z: 100;
        border-radius: 15px;
        background: root.light-theme ? #3b78c4 : #79b8ff;
        Text {
            text: root.drag-count;
            color: #ffffff;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.dragging && root.dragged : Rectangle {
        x: 0px;
        y: root.drag-pointer-y + 12px;
        width: parent.width;
        height: 3px;
        z: 101;
        background: root.light-theme ? #3b78c4 : #79b8ff;
        border-radius: 1.5px;
    }
}

component ExplorerList inherits ListView {
    in property <bool> light-theme;
    in property <[TreeRow]> rows;
    in property <string> edit-path;
    in-out property <string> edit-text: "";
    in property <int> scroll-to-index: -1;
    in property <int> selected-count: 1;
    property <length> row-top: root.scroll-to-index * 26px;
    property <length> viewport-top: 0px - root.viewport-y;
    callback row-clicked(string, bool);
    callback tree-context-menu(string, length, length);
    callback tree-trash-requested(string);
    callback tree-drop-requested(string, int, float);
    callback edit-accepted(string, string);
    callback edit-cancelled();

    changed scroll-to-index => {
        if root.scroll-to-index >= 0 {
            if root.row-top < root.viewport-top || root.row-top + 26px > root.viewport-top + root.height {
                root.viewport-y = 0px - (root.row-top - (root.height - 26px) / 2);
            }
        }
    }

    for row[index] in root.rows : ExplorerRow {
        light-theme: root.light-theme;
        path: row.path;
        name: row.name;
        depth: row.depth;
        is-dir: row.is-dir;
        is-expanded: row.is-expanded;
        is-selected: row.is-selected;
        kind: row.kind;
        drag-count: root.selected-count;
        editing: root.edit-path == row.path;
        edit-text <=> root.edit-text;
        drag-finished(was-dragged, pointer-y) => {
            if was-dragged {
                root.tree-drop-requested(row.path, index, pointer-y);
            }
        }
        clicked(shift) => { root.row-clicked(row.path, shift); }
        right-clicked(x, y) => { root.tree-context-menu(row.path, x, y); }
        edit-accepted(text) => { root.edit-accepted(row.path, text); }
        edit-cancelled => { root.edit-cancelled(); }
    }
}

export component MainWindow inherits Window {
    title: "Adb Studio";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 560px;
    background: #11151b;
    forward-focus: keyboard-focus;

    in-out property <bool> light-theme: false;
    in-out property <color> comment-background-color: #000000;
    in-out property <color> comment-text-color: #ffffff;
    in-out property <string> comment-background-hex: "#000000";
    in-out property <string> comment-text-hex: "#ffffff";
    in-out property <int> theme-index: 0;
    in-out property <bool> color-picker-visible: false;
    in-out property <int> color-picker-target: 0;
    in-out property <string> color-picker-value: "#000000";
    in-out property <bool> has-folder: false;
    in-out property <string> folder-name: "";
    in-out property <string> build-number: "development";
    in-out property <bool> about-visible: false;
    in-out property <bool> settings-visible: false;
    in-out property <int> settings-tab: 0;
    in-out property <bool> tips-visible: false;
    in-out property <bool> hide-tips-of-the-day: false;
    in-out property <bool> comfyui-sync-visible: false;
    in-out property <string> comfyui-sync-url: "";
    in-out property <string> comfyui-sync-remote-directory: "output/audio";
    in-out property <string> comfyui-sync-local-directory: "downloads";
    in-out property <string> comfyui-sync-interval: "4000";
    in-out property <string> comfyui-sync-error: "";
    in-out property <string> comfyui-sync-test-message: "";
    in-out property <bool> comfyui-sync-test-success: false;
    in-out property <string> comfyui-sync-status: "Not configured";
    in-out property <string> comfyui-sync-spinner: "|";
    in-out property <int> comfyui-sync-present: 0;
    in-out property <int> comfyui-sync-total: 0;
    in-out property <bool> comfyui-sync-active: false;
    in-out property <bool> comfyui-sync-error-state: false;
    in-out property <bool> file-menu-visible: false;
    in-out property <bool> edit-menu-visible: false;
    in-out property <bool> view-menu-visible: false;
    in-out property <bool> help-menu-visible: false;
    in-out property <bool> tree-menu-visible: false;
    in-out property <bool> sort-menu-visible: false;
    in-out property <int> sort-order: 3;
    in-out property <string> tree-menu-path: "";
    in-out property <length> tree-menu-x: 0px;
    in-out property <length> tree-menu-y: 0px;
    in-out property <string> tree-edit-path: "";
    in-out property <string> tree-edit-text: "";
    in-out property <int> tree-edit-mode: 0;
    in-out property <bool> conversion-options-visible: false;
    in-out property <bool> conversion-progress-visible: false;
    in-out property <int> conversion-format-index: 0;
    in-out property <int> conversion-quality-index: 1;
    property <[string]> conversion-quality-labels: root.conversion-format-index == 0
        ? ["96 kbps", "128 kbps", "192 kbps", "320 kbps (maximum)"]
        : root.conversion-format-index == 1
        ? ["96 kbps", "128 kbps", "192 kbps", "256 kbps (maximum)"]
        : root.conversion-format-index == 2
        ? ["64 kbps", "96 kbps", "128 kbps", "192 kbps (maximum)"]
        : root.conversion-format-index == 3
        ? ["Compression level 1", "Compression level 5", "Compression level 8", "Compression level 12 (maximum)"]
        : ["PCM 16-bit", "PCM 24-bit", "PCM 32-bit", "PCM 32-bit float (maximum)"];
    property <[string]> conversion-quality-values: ["Low", "Medium", "High", "Maximum"];
    in-out property <[ConversionRow]> conversion-rows: [];
    in-out property <bool> conversion-complete: false;
    in-out property <bool> left-pane-visible: true;
    in-out property <length> left-pane-width: 280px;
    callback left-pane-width-changed(length);
    in-out property <[TreeRow]> tree-rows: [];
    in-out property <int> tree-selection-count: 1;
    in-out property <int> tree-scroll-to-index: -1;
    in-out property <[BreadcrumbRow]> audio-breadcrumbs: [];
    in-out property <[AudioRow]> audio-rows: [];
    in-out property <int> audio-scroll-to-index: -1;
    in-out property <int> audio-viewport-start: 0;
    in-out property <int> audio-visible-rows: 0;
    in-out property <string> audio-filter: "";
    in-out property <string> selected-name: "";
    in-out property <bool> audio-loading: false;
    in-out property <int> audio-completed: 0;
    in-out property <int> audio-total: 0;
    in-out property <string> audio-spinner: "|";
    in-out property <string> active-audio-path: "";
    in-out property <string> selected-audio-path: "";
    in-out property <string> audio-file-name: "";
    in-out property <bool> audio-playing: false;
    in-out property <bool> loop-enabled: false;
    in-out property <bool> auto-play-new-tracks: false;
    in-out property <int> seek-seconds: 5;
    in-out property <int> shortcut-fullscreen: 0;
    in-out property <int> shortcut-metadata: 1;
    in-out property <int> shortcut-play-pause: 2;
    in-out property <int> shortcut-navigate-up: 3;
    in-out property <int> shortcut-navigate-down: 4;
    in-out property <int> shortcut-cancel-edit: 5;
    in-out property <int> shortcut-seek-backward: 7;
    in-out property <int> shortcut-seek-forward: 8;
    in-out property <int> shortcut-trash: 9;
    in-out property <float> audio-volume: 1.0;
    in-out property <string> audio-current-time: "00:00";
    in-out property <string> audio-total-duration: "00:00";
    in-out property <string> audio-error: "";
    in-out property <bool> trash-confirm-visible: false;
    in-out property <string> trash-confirm-path: "";
    in-out property <bool> trash-confirm-dont-ask: false;
    in-out property <bool> metadata-visible: false;
    in-out property <length> metadata-pane-height: 190px;
    property <length> metadata-drag-start-y: 0px;
    property <length> metadata-drag-start-height: 190px;
    in-out property <[WorkflowFileRow]> workflow-json-files: [];
    in-out property <string> selected-workflow: "";
    in-out property <bool> workflow-dropdown-visible: false;
    in-out property <string> workflow-bpm: "";
    in-out property <int> workflow-bpm-number: 0;
    in-out property <string> workflow-key: "";
    in-out property <int> workflow-key-index: -1;
    in-out property <string> workflow-seed: "";
    in-out property <int> workflow-seed-number: 0;
    in-out property <string> workflow-model: "";
    in-out property <string> workflow-prompt: "";
    in-out property <string> workflow-lyrics: "";
    in-out property <[WorkflowLoraRow]> workflow-loras: [];
    in-out property <bool> workflow-modified: false;
    in-out property <bool> workflow-loading: false;
    in-out property <bool> lora-editor-visible: false;
    in-out property <string> lora-editor-filename: "";
    in-out property <string> lora-editor-tag: "";
    callback open-folder();
    callback close-folder();
    callback close-about();
    callback close-settings();
    callback close-tips();
    callback tips-preference-changed(bool);
    callback comfyui-sync-requested();
    callback comfyui-sync-save(string, string, string, string);
    callback comfyui-sync-test(string, string, string, string);
    callback comfyui-sync-cancel();
    callback comfyui-sync-choose-directory();
    callback toggle-fullscreen();
    callback theme-selected(bool);
    callback comment-colors-selected(string, string);
    callback row-clicked(string, bool);
    callback breadcrumb-requested(string);
    callback audio-row-selected(string);
    callback audio-navigate(int);
    callback tree-context-menu(string);
    callback conversion-requested(string);
    callback conversion-started(string, string);
    callback conversion-cancelled();
    callback conversion-closed();
    callback sort-order-selected(int);
    callback tree-trash-requested(string);
    callback tree-drop-requested(string, int, float);
    callback rename-requested();
    callback tree-reveal-requested(string);
    callback new-folder-requested(string);
    callback tree-edit-accepted(string, string, int);
    callback tree-edit-cancelled();
    callback filter-changed(string);
    callback audio-viewport-changed(int, int);
    callback audio-play-pause();
    callback audio-seek(string, float);
    callback audio-play(string);
    callback loop-changed(bool);
    callback auto-play-new-tracks-changed(bool);
    callback seek-seconds-changed(int);
    callback shortcut-changed(int, int);
    callback global-key-pressed(int, bool);
    callback volume-changed(float);
    callback comment-range-requested(string, float, float);
    callback comment-selected(string, float, float, string);
    callback comment-edit-requested(string, float, float, string);
    callback comment-range-moved(string, float, float, float, float, string);
    callback rating-requested(string, int);
    callback trash-requested(string);
    callback trash-confirmed(bool);
    callback trash-cancelled();
    callback comment-save(string, string, string, string);
    callback comment-cancel();
    callback comment-delete(string, string, string, string);
    callback metadata-toggle();
    callback metadata-pane-height-changed(length);
    callback workflow-selected(string);
    callback workflow-search-changed(string);
    callback recreate-workflow-requested();
    callback workflow-metadata-changed(string, string);
    callback workflow-number-changed(string, int);
    callback lora-edit-requested(string, string);
    callback lora-save(string, string);
    callback lora-cancel();
    in-out property <bool> comment-editor-visible: false;
    in-out property <string> comment-editor-path: "";
    in-out property <string> comment-editor-start: "0";
    in-out property <string> comment-editor-end: "0";
    in-out property <string> comment-editor-text: "";

    changed left-pane-width => {
        root.left-pane-width-changed(root.left-pane-width);
    }

    changed metadata-pane-height => {
        root.metadata-pane-height-changed(root.metadata-pane-height);
    }

    keyboard-focus := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.F11 { root.global-key-pressed(0, event.modifiers.shift); accept; }
            if event.text == Key.F9 { root.global-key-pressed(1, event.modifiers.shift); accept; }
            if event.text == Key.Space { root.global-key-pressed(2, event.modifiers.shift); accept; }
            if event.text == Key.UpArrow { root.global-key-pressed(3, event.modifiers.shift); accept; }
            if event.text == Key.DownArrow { root.global-key-pressed(4, event.modifiers.shift); accept; }
            if event.text == Key.Escape { root.global-key-pressed(5, event.modifiers.shift); accept; }
            if event.text == Key.F2 { root.global-key-pressed(6, event.modifiers.shift); accept; }
            if event.text == Key.LeftArrow { root.global-key-pressed(7, event.modifiers.shift); accept; }
            if event.text == Key.RightArrow { root.global-key-pressed(8, event.modifiers.shift); accept; }
            if event.text == Key.Delete { root.global-key-pressed(9, event.modifiers.shift); accept; }
            reject;
        }

    Rectangle {
        background: root.light-theme ? #f5f7fa : #11151b;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.workflow-dropdown-visible = false;
                root.tree-menu-visible = false;
                root.sort-menu-visible = false;
                if root.tree-edit-path != "" {
                    root.tree-edit-cancelled();
                }
            }
        }

        VerticalBox {
            spacing: 0px;

            Rectangle {
                height: 40px;
                background: root.light-theme ? #eef1f5 : #1a2029;
                border-color: root.light-theme ? #cbd2dc : #2a3340;
                border-width: 1px;

                HorizontalLayout {
                    spacing: 0px;
                    MenuButton {
                        label: "File";
                        light-theme: root.light-theme;
                        clicked => {
                            root.file-menu-visible = !root.file-menu-visible;
                            root.edit-menu-visible = false;
                            root.view-menu-visible = false;
                            root.help-menu-visible = false;
                        }
                    }
                    MenuButton {
                        label: "Edit";
                        light-theme: root.light-theme;
                        clicked => {
                            root.edit-menu-visible = !root.edit-menu-visible;
                            root.file-menu-visible = false;
                            root.view-menu-visible = false;
                            root.help-menu-visible = false;
                        }
                    }
                    MenuButton {
                        label: "View";
                        light-theme: root.light-theme;
                        clicked => {
                            root.view-menu-visible = !root.view-menu-visible;
                            root.file-menu-visible = false;
                            root.edit-menu-visible = false;
                            root.help-menu-visible = false;
                        }
                    }
                    MenuButton {
                        label: "Help";
                        light-theme: root.light-theme;
                        clicked => {
                            root.help-menu-visible = !root.help-menu-visible;
                            root.file-menu-visible = false;
                            root.edit-menu-visible = false;
                            root.view-menu-visible = false;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 110px;
                        Text {
                            text: "Adb Studio";
                            width: parent.width - 14px;
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            font-size: 13px;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                Rectangle {
                    width: 48px;
                    background: root.light-theme ? #e7ebf0 : #171c24;
                    border-color: root.light-theme ? #cbd2dc : #2a3340;
                    border-width: 1px;

                    VerticalBox {
                        alignment: start;
                        ToolButton {
                            icon: @image-url("../assets/icons/panel-left.svg");
                            light-theme: root.light-theme;
                            clicked => { root.left-pane-visible = !root.left-pane-visible; }
                        }
                    }
                }

                if root.left-pane-visible : Rectangle {
                    width: root.left-pane-width;
                    background: root.light-theme ? #eef1f5 : #1a2029;
                    border-color: root.light-theme ? #cbd2dc : #2a3340;
                    border-width: 1px;

                    if root.has-folder : VerticalBox {
                        padding: 18px;
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        Rectangle {
                            height: 28px;
                            z: 100;
                            HorizontalLayout {
                                Text {
                                    text: "EXPLORER";
                                    color: root.light-theme ? #5c6878 : #7f8b9d;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        Text {
                            text: root.folder-name;
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 15px;
                            overflow: elide;
                            x: 12px;
                        }
                        Rectangle {
                            height: 1px;
                            background: root.light-theme ? #cbd2dc : #2a3340;
                        }
                        tree-focus := FocusScope {
                            vertical-stretch: 1;
                            key-pressed(event) => {
                                if event.text == Key.F2 {
                                    root.rename-requested();
                                    accept;
                                }
                                reject;
                            }
                            tree-list := ExplorerList {
                                width: 100%;
                                height: 100%;
                                light-theme: root.light-theme;
                                rows: root.tree-rows;
                                selected-count: root.tree-selection-count;
                                edit-path: root.tree-edit-path;
                                edit-text <=> root.tree-edit-text;
                                scroll-to-index: root.tree-scroll-to-index;
                                row-clicked(path, shift) => {
                                    root.tree-menu-visible = false;
                                    if root.tree-edit-path != "" && root.tree-edit-path != path {
                                        root.tree-edit-cancelled();
                                    } else {
                                        tree-focus.focus();
                                        root.row-clicked(path, shift);
                                    }
                                }
                                tree-context-menu(path, x, y) => {
                                    if root.tree-edit-path != "" && root.tree-edit-path != path {
                                        root.tree-edit-cancelled();
                                    }
                                    root.file-menu-visible = false;
                                    root.edit-menu-visible = false;
                                    root.view-menu-visible = false;
                                    root.help-menu-visible = false;
                                    tree-focus.focus();
                                    root.tree-menu-path = path;
                                    root.tree-menu-x = x;
                                    root.tree-menu-y = y;
                                    root.tree-menu-visible = true;
                                }
                                tree-trash-requested(path) => { root.tree-trash-requested(path); }
                                tree-drop-requested(path, index, pointer-y) => { root.tree-drop-requested(path, index, pointer-y); }
                                edit-accepted(path, text) => { root.tree-edit-accepted(path, text, root.tree-edit-mode); }
                                edit-cancelled => { root.tree-edit-cancelled(); }
                            }
                            }
                    }

                    if !root.has-folder : VerticalBox {
                        padding: 18px;
                        spacing: 12px;
                        Text {
                            text: "EXPLORER";
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            font-size: 11px;
                        }
                        Text {
                            text: "No folder open";
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 15px;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                if root.left-pane-visible : Rectangle {
                    width: 6px;
                    background: drag-area.has-hover ? (root.light-theme ? #aeb8c6 : #566171) : (root.light-theme ? #e0e5eb : #3b4655);

                    VerticalBox {
                        alignment: center;
                        spacing: 2px;
                        Rectangle {
                            width: 3px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: drag-area.has-hover ? (root.light-theme ? #f5f7fa : #d7dce5) : (root.light-theme ? #8b96a7 : #8b96a7);
                        }
                        Rectangle {
                            width: 3px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: drag-area.has-hover ? (root.light-theme ? #f5f7fa : #d7dce5) : (root.light-theme ? #8b96a7 : #8b96a7);
                        }
                        Rectangle {
                            width: 3px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: drag-area.has-hover ? (root.light-theme ? #f5f7fa : #d7dce5) : (root.light-theme ? #8b96a7 : #8b96a7);
                        }
                    }

                    drag-area := TouchArea {
                        mouse-cursor: ew-resize;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.move && self.pressed {
                                root.left-pane-width = (parent.x + self.mouse-x - 48px).max(180px).min(600px);
                            }
                        }
                    }
                }

                Rectangle {
                    background: root.light-theme ? #f5f7fa : #11151b;
                    horizontal-stretch: 1;

                    if !root.has-folder : VerticalBox {
                        alignment: center;
                        spacing: 14px;
                        Text {
                            text: "Welcome to Adb Studio";
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 28px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Open a workspace folder to begin organizing your audio.";
                            color: root.light-theme ? #5c6878 : #8b96a7;
                            horizontal-alignment: center;
                        }
                        AppButton {
                            text: "Open Folder...";
                            clicked => { root.open-folder(); }
                        }
                    }

                    if root.has-folder : VerticalBox {
                        padding: 24px;
                        padding-bottom: 0px;
                        spacing: 18px;
                        Rectangle {
                            height: 28px;
                            HorizontalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    spacing: 0px;
                                    for breadcrumb[index] in root.audio-breadcrumbs : Rectangle {
                                        height: 28px;
                                        width: breadcrumb-name.preferred-width + (index < root.audio-breadcrumbs.length - 1 ? 42px : 0px);
                                        breadcrumb-name := Text {
                                            text: breadcrumb.name;
                                            color: index < root.audio-breadcrumbs.length - 1 ? (root.light-theme ? #5c6878 : #8b96a7) : (root.light-theme ? #202833 : #e3e8ef);
                                            font-size: 18px;
                                            vertical-alignment: center;
                                        }
                                        if index < root.audio-breadcrumbs.length - 1 : Text {
                                            text: ">";
                                            x: breadcrumb-name.x + breadcrumb-name.width + 4px;
                                            color: root.light-theme ? #8b96a7 : #687487;
                                            font-size: 16px;
                                            vertical-alignment: center;
                                        }
                                        if index < root.audio-breadcrumbs.length - 1 : TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.breadcrumb-requested(breadcrumb.path); }
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                LineEdit {
                                    placeholder-text: "Filter audio files...";
                                    width: 260px;
                                    text <=> root.audio-filter;
                                    edited(text) => { root.filter-changed(text); }
                                }
                                SortIconButton {
                                    icon: @image-url("../assets/icons/ellipsis-vertical.svg");
                                    light-theme: root.light-theme;
                                    clicked => { root.sort-menu-visible = !root.sort-menu-visible; }
                                }
                            }
                        }
                        Rectangle {
                            background: root.light-theme ? #eef1f5 : #1a2029;
                            border-color: root.light-theme ? #cbd2dc : #2a3340;
                            border-width: 1px;
                            vertical-stretch: 1;
                            if root.audio-rows.length == 0 : Text {
                                text: root.audio-filter == "" ? "No audio files in this folder." : "No matching audio files.";
                                color: root.light-theme ? #5c6878 : #8b96a7;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if root.audio-rows.length > 0 : AudioList {
                                light-theme: root.light-theme;
                                comment-background-color: root.comment-background-color;
                                comment-text-color: root.comment-text-color;
                                rows: root.audio-rows;
                                scroll-to-index: root.audio-scroll-to-index;
                                width: 100%;
                                height: 100%;
                                viewport-changed(start-index, visible-rows) => {
                                    root.audio-viewport-start = start-index;
                                    root.audio-visible-rows = visible-rows;
                                    root.audio-viewport-changed(start-index, visible-rows);
                                }
                                row-selected(path) => { root.audio-row-selected(path); }
                                seek-requested(path, progress) => { root.audio-seek(path, progress); }
                                play-requested(path) => { root.audio-play(path); }
                                comment-range-requested(path, start, end) => { root.comment-range-requested(path, start, end); }
                                comment-selected(path, start, end, text) => { root.comment-selected(path, start, end, text); }
                                comment-edit-requested(path, start, end, text) => { root.comment-edit-requested(path, start, end, text); }
                                comment-range-moved(path, old-start, old-end, start, end, text) => { root.comment-range-moved(path, old-start, old-end, start, end, text); }
                                rating-requested(path, rating) => { root.rating-requested(path, rating); }
                                trash-requested(path) => { root.trash-requested(path); }
                            }
                            if root.sort-menu-visible : Rectangle {
                                x: parent.width - 196px;
                                y: -14px;
                                width: 190px;
                                height: 128px;
                                z: 1000;
                                background: root.light-theme ? #ffffff : #202832;
                                border-color: root.light-theme ? #cbd2dc : #435064;
                                border-width: 1px;
                                for option[index] in ["Alphabetically ↑", "Alphabetically ↓", "Modified ↑", "Modified ↓"] : Rectangle {
                                    y: index * 31px;
                                    width: parent.width;
                                    height: 31px;
                                    background: root.sort-order == index ? (root.light-theme ? #e7ebf0 : #2a3543) : transparent;
                                    Text {
                                        text: option;
                                        x: 10px;
                                        color: root.light-theme ? #202833 : #d7dce5;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.sort-order = index;
                                            root.sort-menu-visible = false;
                                            root.sort-order-selected(index);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: root.metadata-visible ? root.metadata-pane-height + 26px : 0px;
                z: 1;
                if root.metadata-visible : VerticalBox {
                    spacing: 0px;
                    Rectangle {
                        height: 6px;
                        background: metadata-drag-area.has-hover ? (root.light-theme ? #aeb8c6 : #566171) : (root.light-theme ? #e0e5eb : #3b4655);
                        metadata-drag-area := TouchArea {
                            mouse-cursor: ns-resize;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down {
                                    root.metadata-drag-start-y = self.mouse-y;
                                    root.metadata-drag-start-height = root.metadata-pane-height;
                                } else if event.kind == PointerEventKind.move && self.pressed {
                                    root.metadata-pane-height = (root.metadata-drag-start-height - (self.mouse-y - root.metadata-drag-start-y)).max(120px).min(420px);
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: root.metadata-pane-height + 20px;
                        background: root.workflow-modified ? #d46b32 : (root.light-theme ? #eef1f5 : #1a2029);
                        border-color: root.light-theme ? #cbd2dc : #2a3340;
                        border-width: 1px;
                        CompactIconButton {
                            x: parent.width - self.width - 6px;
                            y: 6px;
                            icon: @image-url("../assets/icons/x.svg");
                            clicked => { root.metadata-toggle(); }
                        }
                        VerticalBox {
                            width: 100%;
                            height: 100%;
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                width: 100%;
                                height: (root.metadata-pane-height - 58px);
                                spacing: 12px;
                                VerticalBox {
                                    width: (parent.width - 36px) / 4;
                                    height: 100%;
                                    alignment: start;
                                    spacing: 6px;
                                    Text { text: "Duration\n" + root.audio-total-duration; color: root.workflow-modified ? #ffffff : (root.light-theme ? #202833 : #e3e8ef); }
                                    WorkflowSuggestionBox {
                                        width: 100%;
                                        files: root.workflow-json-files;
                                        light-theme: root.light-theme;
                                        list-visible <=> root.workflow-dropdown-visible;
                                        query <=> root.selected-workflow;
                                        selected(path) => { root.workflow-selected(path); }
                                        search-requested(query) => { root.workflow-search-changed(query); }
                                    }
                                    Text { text: "BPM"; color: root.workflow-modified ? #ffffff : (root.light-theme ? #202833 : #e3e8ef); }
                                    SpinBox {
                                        minimum: 0;
                                        value <=> root.workflow-bpm-number;
                                        edited(value) => { root.workflow-number-changed("bpm", self.value); }
                                    }
                                    Text { text: "Key"; color: root.workflow-modified ? #ffffff : (root.light-theme ? #202833 : #e3e8ef); }
                                    ComboBox {
                                        model: ["C major", "C minor", "C# major", "C# minor", "D major", "D minor", "Eb major", "Eb minor", "E major", "E minor", "F major", "F minor", "F# major", "F# minor", "G major", "G minor", "Ab major", "Ab minor", "A major", "A minor", "Bb major", "Bb minor", "B major", "B minor"];
                                        current-index: root.workflow-key-index;
                                        changed current-index => {
                                            if self.current-index >= 0 {
                                                root.workflow-metadata-changed("key", self.model[self.current-index]);
                                            }
                                        }
                                    }
                                    Text { text: "Seed"; color: root.workflow-modified ? #ffffff : (root.light-theme ? #202833 : #e3e8ef); }
                                    SpinBox {
                                        minimum: 0;
                                        value <=> root.workflow-seed-number;
                                        edited(value) => { root.workflow-number-changed("seed", self.value); }
                                    }
                                }
                                    VerticalBox {
                                    width: (parent.width - 36px) / 4;
                                    height: 100%;
                                    Text { text: "Prompt"; color: root.workflow-modified ? #ffffff : (root.light-theme ? #202833 : #e3e8ef); }
                                    TextEdit {
                                        width: 100%;
                                        height: 100%;
                                        text <=> root.workflow-prompt;
                                        wrap: word-wrap;
                                        edited(text) => { root.workflow-metadata-changed("prompt", self.text); }
                                    }
                                }
                                VerticalBox {
                                    width: (parent.width - 36px) / 4;
                                    height: 100%;
                                    Text { text: "Lyrics"; color: root.workflow-modified ? #ffffff : (root.light-theme ? #202833 : #e3e8ef); }
                                    TextEdit {
                                        width: 100%;
                                        height: 100%;
                                        text <=> root.workflow-lyrics;
                                        wrap: word-wrap;
                                        edited(text) => { root.workflow-metadata-changed("lyrics", self.text); }
                                    }
                                }
                                VerticalBox {
                                    width: (parent.width - 36px) / 4;
                                    height: 100%;
                                    Text { text: "Model\n" + (root.workflow-model == "" ? "-" : root.workflow-model); color: root.workflow-modified ? #ffffff : (root.light-theme ? #202833 : #e3e8ef); overflow: elide; }
                                    Text { text: "LoRAs"; color: root.workflow-modified ? #ffffff : (root.light-theme ? #202833 : #e3e8ef); }
                                    ListView {
                                        height: 100%;
                                        vertical-scrollbar-policy: always-on;
                                        for lora in root.workflow-loras : HorizontalLayout {
                                            height: 26px;
                                            spacing: 4px;
                                            Text {
                                                text: lora.filename + (lora.strength == "" ? "" : "  x" + lora.strength);
                                                color: root.workflow-modified ? #ffffff : (root.light-theme ? #5c6878 : #aeb8c6);
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: lora.custom-tag;
                                                color: root.workflow-modified ? #ffffff : (root.light-theme ? #202833 : #e3e8ef);
                                                width: 90px;
                                                overflow: elide;
                                            }
                                            AppButton {
                                                text: "Edit";
                                                clicked => { root.lora-edit-requested(lora.filename, lora.custom-tag); }
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                alignment: end;
                                AppButton {
                                    text: "Recreate in ComfyUI";
                                    clicked => { root.recreate-workflow-requested(); }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 80px;
                background: #ffffff;
                HorizontalLayout {
                    height: 100%;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 12px;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 20px;
                        background: #ffffff;
                        border-color: root.light-theme ? (play-area.has-hover ? #b8c0ca : #b8c0ca80) : (play-area.has-hover ? #566171 : #56617180);
                        border-width: 2px;
                        Image {
                            source: root.audio-playing
                                ? @image-url("../assets/icons/pause.svg")
                                : @image-url("../assets/icons/play.svg");
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 18px;
                            height: 18px;
                            opacity: root.active-audio-path != "" && root.audio-error == "" ? (play-area.has-hover ? 1 : 0.5) : 0.35;
                        }
                        play-area := TouchArea {
                            enabled: root.active-audio-path != "" && root.audio-error == "";
                            clicked => { root.audio-play-pause(); }
                        }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("../assets/icons/repeat-2.svg");
                        active: root.loop-enabled;
                        clicked => {
                            root.loop-enabled = !root.loop-enabled;
                            root.loop-changed(root.loop-enabled);
                        }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("../assets/icons/audio-lines.svg");
                        active: root.auto-play-new-tracks;
                        clicked => {
                            root.auto-play-new-tracks = !root.auto-play-new-tracks;
                            root.auto-play-new-tracks-changed(root.auto-play-new-tracks);
                        }
                    }
                    Text {
                        text: root.audio-current-time + " / " + root.audio-total-duration;
                        color: root.light-theme ? #5c6878 : #aeb8c6;
                        vertical-alignment: center;
                    }
                    Image {
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../assets/icons/volume-2.svg");
                        width: 20px;
                        height: 20px;
                        vertical-alignment: center;
                    }
                    Slider {
                        value <=> root.audio-volume;
                        minimum: 0;
                        maximum: 1;
                        width: 110px;
                        changed => { root.volume-changed(self.value); }
                    }
                    SyncIconButton {
                        icon: root.comfyui-sync-error-state
                            ? @image-url("../assets/icons/cloud-alert.svg")
                            : root.comfyui-sync-active
                                ? @image-url("../assets/icons/cloud-sync-active.svg")
                                : @image-url("../assets/icons/cloud-sync.svg");
                        tooltip: "ComfyUI sync";
                        status: root.comfyui-sync-status + "  " + root.comfyui-sync-present + "/" + root.comfyui-sync-total;
                        clicked => { root.comfyui-sync-requested(); }
                    }
                    Text {
                        text: root.audio-error;
                        color: #d46b32;
                        vertical-alignment: center;
                        overflow: elide;
                        width: 260px;
                    }
                }
            }

            Rectangle {
                height: 32px;
                background: root.light-theme ? #eef1f5 : #1a2029;
                border-color: root.light-theme ? #cbd2dc : #2a3340;
                border-width: 1px;
                Text {
                    text: !root.has-folder ? "No workspace folder opened" : root.selected-name == "" ? "Workspace: " + root.folder-name : "Workspace: " + root.folder-name + "  —  Selected: " + root.selected-name;
                    color: root.light-theme ? #5c6878 : #7f8b9d;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    padding-right: 12px;
                    spacing: 6px;
                    Rectangle { horizontal-stretch: 1; }
                    if root.audio-loading : Text {
                        text: root.audio-spinner;
                        color: root.light-theme ? #d46b32 : #e58a4d;
                        font-size: 16px;
                    }
                    Text {
                        text: root.audio-loading ? "Waveforms " + root.audio-completed + "/" + root.audio-total : "";
                        color: root.light-theme ? #5c6878 : #7f8b9d;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    if root.comfyui-sync-active || root.comfyui-sync-error-state : Rectangle {
                        width: sync-status-text.preferred-width + (root.comfyui-sync-active ? 22px : 8px);
                        height: 28px;
                        background: transparent;
                        if root.comfyui-sync-active : Text {
                            text: root.comfyui-sync-spinner;
                            x: 4px;
                            width: 14px;
                            color: root.light-theme ? #d46b32 : #e58a4d;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        sync-status-text := Text {
                            x: root.comfyui-sync-active ? 20px : 4px;
                            text: root.comfyui-sync-error-state
                                ? "Syncing error..."
                                : "Syncing " + root.comfyui-sync-present + "/" + root.comfyui-sync-total;
                            color: root.comfyui-sync-error-state
                                ? #d46b32
                                : (root.light-theme ? #5c6878 : #7f8b9d);
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.comfyui-sync-requested(); } }
                    }
                    CompactIconButton {
                        icon: @image-url("../assets/icons/file-code-2.svg");
                        active: root.metadata-visible;
                        clicked => { root.metadata-toggle(); }
                    }
                }
            }
        }

        if root.file-menu-visible : Rectangle {
            x: 0px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "Open Folder...";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.file-menu-visible = false;
                    root.open-folder();
                }
            }
        }

        if root.edit-menu-visible : Rectangle {
            x: 70px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "Settings";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.edit-menu-visible = false;
                    root.settings-visible = true;
                }
            }
        }

        if root.view-menu-visible : Rectangle {
            x: 140px;
            y: 40px;
            width: 210px;
            height: 84px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Rectangle {
                width: 100%;
                height: 100%;
                background: fullscreen-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "Toggle full screen";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    width: parent.width - 70px;
                    vertical-alignment: center;
                }
                Text {
                    text: "F11";
                    color: root.light-theme ? #5c6878 : #aeb8c6;
                    x: parent.width - 56px;
                    width: 42px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                fullscreen-touch := TouchArea {
                    clicked => {
                        root.view-menu-visible = false;
                        root.toggle-fullscreen();
                    }
                }
            }
            Rectangle {
                y: 42px;
                width: 100%;
                height: 1px;
                background: root.light-theme ? #cbd2dc : #435064;
            }
            Rectangle {
                y: 43px;
                width: 100%;
                height: 41px;
                background: metadata-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "Toggle metadata";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    width: parent.width - 70px;
                    vertical-alignment: center;
                }
                Text {
                    text: "F9";
                    color: root.light-theme ? #5c6878 : #aeb8c6;
                    x: parent.width - 56px;
                    width: 42px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                metadata-touch := TouchArea {
                    clicked => {
                        root.view-menu-visible = false;
                        root.metadata-toggle();
                    }
                }
            }
        }

        if root.help-menu-visible : Rectangle {
            x: 210px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "About";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.help-menu-visible = false;
                    root.about-visible = true;
                }
            }
        }

        if root.tree-menu-visible : Rectangle {
            x: (root.tree-menu-x + 6px).min(parent.width - self.width).max(0px);
            y: (root.tree-menu-y + 6px).min(parent.height - self.height).max(0px);
            width: 210px;
            height: 155px;
            z: 1000;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 31px;
                background: reveal-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "Show in folder...";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    y: 0px;
                    width: 196px;
                    height: 31px;
                    vertical-alignment: center;
                }
                reveal-touch := TouchArea {
                    width: 100%;
                    height: 31px;
                    clicked => {
                        root.tree-menu-visible = false;
                        root.tree-reveal-requested(root.tree-menu-path);
                    }
                }
            }
            Rectangle {
                x: 0px;
                y: 31px;
                width: 100%;
                height: 31px;
                background: rename-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "Rename...  F2";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    y: 0px;
                    width: 196px;
                    height: 31px;
                    vertical-alignment: center;
                }
                rename-touch := TouchArea {
                    width: 100%;
                    height: 31px;
                    clicked => {
                        root.tree-menu-visible = false;
                        root.rename-requested();
                    }
                }
            }
            Rectangle {
                x: 0px;
                y: 62px;
                width: 100%;
                height: 31px;
                background: folder-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "New Folder";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    y: 0px;
                    width: 196px;
                    height: 31px;
                    vertical-alignment: center;
                }
                folder-touch := TouchArea {
                    width: 100%;
                    height: 31px;
                    clicked => {
                        root.tree-menu-visible = false;
                        root.new-folder-requested(root.tree-menu-path);
                    }
                }
            }
            Rectangle {
                x: 0px;
                y: 93px;
                width: 100%;
                height: 31px;
                background: convert-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "Convert to file format...";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    y: 0px;
                    width: 196px;
                    height: 31px;
                    vertical-alignment: center;
                }
                convert-touch := TouchArea {
                    width: 100%;
                    height: 31px;
                    clicked => {
                        root.tree-menu-visible = false;
                        root.conversion-requested(root.tree-menu-path);
                    }
                }
            }
            Rectangle {
                x: 0px;
                y: 124px;
                width: 100%;
                height: 31px;
                background: trash-touch.has-hover ? (root.light-theme ? #e7ebf0 : #2a3546) : transparent;
                Text {
                    text: "Move to Trash";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    x: 14px;
                    y: 0px;
                    width: 196px;
                    height: 31px;
                    vertical-alignment: center;
                }
                trash-touch := TouchArea {
                    width: 100%;
                    height: 31px;
                    clicked => {
                        root.tree-menu-visible = false;
                        root.tree-trash-requested(root.tree-menu-path);
                    }
                }
            }
        }

        if root.conversion-options-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            z: 30;
            Rectangle {
                width: 460px;
                height: 270px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;
                VerticalBox {
                    padding: 24px;
                    spacing: 14px;
                    Text { text: "Convert to file format"; color: root.light-theme ? #202833 : #f1f4f8; font-size: 21px; }
                    Text { text: "Format"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                    ComboBox {
                        model: ["mp3", "ogg", "opus", "flac", "wav"];
                        current-index: root.conversion-format-index;
                        changed current-index => { root.conversion-format-index = self.current-index; }
                    }
                    Text { text: "Quality"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                    ComboBox {
                        model: root.conversion-quality-labels;
                        current-index: root.conversion-quality-index;
                        changed current-index => { root.conversion-quality-index = self.current-index; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        AppButton { text: "Cancel"; clicked => { root.conversion-options-visible = false; } }
                        AppButton {
                            text: "Start conversion...";
                            clicked => {
                                root.conversion-options-visible = false;
                                root.conversion-started(
                                    ["mp3", "ogg", "opus", "flac", "wav"][root.conversion-format-index],
                                    root.conversion-quality-values[root.conversion-quality-index]
                                );
                            }
                        }
                    }
                }
            }
        }

        if root.conversion-progress-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            z: 31;
            Rectangle {
                width: 700px;
                height: 520px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;
                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text { text: "Converting audio"; color: root.light-theme ? #202833 : #f1f4f8; font-size: 21px; }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.conversion-rows : VerticalBox {
                            height: 54px;
                            spacing: 4px;
                            Text { text: row.name; color: root.light-theme ? #202833 : #f1f4f8; overflow: elide; }
                            HorizontalLayout {
                                height: 18px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: root.light-theme ? #e1e6ed : #303b4b;
                                    Rectangle { width: parent.width * row.progress; background: root.light-theme ? #d46b32 : #e58a4d; }
                                }
                                Text { text: row.status; width: 180px; color: root.light-theme ? #5c6878 : #aeb8c6; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        AppButton { text: "Cancel"; enabled: !root.conversion-complete; clicked => { root.conversion-cancelled(); } }
                        AppButton { text: "Close"; enabled: root.conversion-complete; clicked => { root.conversion-closed(); } }
                    }
                }
            }
        }

        if root.about-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            Rectangle {
                width: 390px;
                height: 250px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #202832;
                border-color: #435064;
                border-width: 1px;

                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text {
                        text: "About Adb Studio";
                        color: #f1f4f8;
                        font-size: 22px;
                    }
                    Text { text: "Version 0.1.0"; color: #c4ccd8; }
                    Text { text: "Build: " + root.build-number; color: #c4ccd8; }
                    Text { text: "Author: Alexandre Dupuis-Belin"; color: #c4ccd8; }
                    Rectangle { vertical-stretch: 1; }
                    AppButton {
                        text: "Close";
                        clicked => { root.close-about(); }
                    }
                }
            }
        }

        if root.settings-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            Rectangle {
                width: 760px;
                height: 560px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;

                HorizontalLayout {
                    Rectangle {
                        width: 170px;
                        background: root.light-theme ? #eef1f5 : #171c24;
                        VerticalBox {
                            padding: 20px;
                            spacing: 12px;
                            Text {
                                text: "Settings";
                                color: root.light-theme ? #202833 : #f1f4f8;
                                font-size: 22px;
                            }
                            Rectangle {
                                height: 38px;
                                background: root.light-theme ? #d7e3f3 : #2a3546;
                                border-color: root.light-theme ? #8ea9c6 : #5d7898;
                                border-width: 1px;
                                Text {
                                    text: "Look Feel";
                                    x: 12px;
                                    color: root.light-theme ? #202833 : #f1f4f8;
                                    vertical-alignment: center;
                                }
                                TouchArea { clicked => { root.settings-tab = 0; } }
                            }
                            Rectangle {
                                height: 38px;
                                background: root.settings-tab == 1 ? (root.light-theme ? #d7e3f3 : #2a3546) : transparent;
                                border-color: root.settings-tab == 1 ? (root.light-theme ? #8ea9c6 : #5d7898) : transparent;
                                border-width: 1px;
                                Text {
                                    text: "Keyboard shortcuts";
                                    x: 12px;
                                    color: root.light-theme ? #202833 : #f1f4f8;
                                    vertical-alignment: center;
                                }
                                TouchArea { clicked => { root.settings-tab = 1; } }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        if root.settings-tab == 0 : VerticalBox {
                            padding: 24px;
                            spacing: 14px;
                            Text {
                                text: "Look Feel";
                                color: root.light-theme ? #202833 : #f1f4f8;
                                font-size: 22px;
                            }
                            Text {
                                text: "Theme";
                                color: root.light-theme ? #5c6878 : #c4ccd8;
                            }
                            ComboBox {
                                model: ["Dark theme", "Light theme"];
                                current-index: root.theme-index;
                                changed current-index => { root.theme-selected(self.current-index == 1); }
                            }
                            CheckBox {
                                text: "Don't show tips of the day anymore";
                                checked: root.hide-tips-of-the-day;
                                toggled => { root.tips-preference-changed(self.checked); }
                            }
                            Text {
                                text: "Comment bubbles";
                                color: root.light-theme ? #5c6878 : #c4ccd8;
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "Background"; width: 100px; color: root.light-theme ? #202833 : #e3e8ef; vertical-alignment: center; }
                                Rectangle {
                                    width: 42px;
                                    height: 28px;
                                    background: root.comment-background-color;
                                    border-color: root.comment-text-color;
                                    border-width: 1px;
                                    TouchArea {
                                        clicked => {
                                            root.color-picker-target = 0;
                                            root.color-picker-value = root.comment-background-hex;
                                            root.color-picker-visible = true;
                                        }
                                    }
                                }
                                Text { text: root.comment-background-hex; color: root.light-theme ? #5c6878 : #aeb8c6; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "Text"; width: 100px; color: root.light-theme ? #202833 : #e3e8ef; vertical-alignment: center; }
                                Rectangle {
                                    width: 42px;
                                    height: 28px;
                                    background: root.comment-text-color;
                                    border-color: root.comment-background-color;
                                    border-width: 1px;
                                    TouchArea {
                                        clicked => {
                                            root.color-picker-target = 1;
                                            root.color-picker-value = root.comment-text-hex;
                                            root.color-picker-visible = true;
                                        }
                                    }
                                }
                                Text { text: root.comment-text-hex; color: root.light-theme ? #5c6878 : #aeb8c6; vertical-alignment: center; }
                            }
                            Rectangle { vertical-stretch: 1; }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                AppButton { text: "Close"; clicked => { root.close-settings(); } }
                            }
                        }
                        if root.settings-tab == 1 : VerticalBox {
                            padding: 24px;
                            spacing: 14px;
                            Text {
                                text: "Keyboard shortcuts";
                                color: root.light-theme ? #202833 : #f1f4f8;
                                font-size: 22px;
                            }
                            Text { text: "Playback"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "Seek step"; width: 130px; color: root.light-theme ? #202833 : #e3e8ef; vertical-alignment: center; }
                                ComboBox {
                                    model: ["1 second", "2 seconds", "3 seconds", "4 seconds", "5 seconds", "10 seconds", "15 seconds", "30 seconds"];
                                    current-index: root.seek-seconds == 1 ? 0 : root.seek-seconds == 2 ? 1 : root.seek-seconds == 3 ? 2 : root.seek-seconds == 4 ? 3 : root.seek-seconds == 10 ? 5 : root.seek-seconds == 15 ? 6 : root.seek-seconds == 30 ? 7 : 4;
                                    changed current-index => { root.seek-seconds-changed(self.current-index == 0 ? 1 : self.current-index == 1 ? 2 : self.current-index == 2 ? 3 : self.current-index == 3 ? 4 : self.current-index == 5 ? 10 : self.current-index == 6 ? 15 : self.current-index == 7 ? 30 : 5); }
                                }
                            }
                            Text { text: "Keys"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                            VerticalBox {
                                spacing: 5px;
                                property <[string]> shortcut-keys: ["F11", "F9", "Space", "Up", "Down", "Escape", "F2", "Left", "Right", "Delete"];
                                HorizontalLayout { Text { text: "Fullscreen"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-fullscreen; changed current-index => { root.shortcut-changed(0, self.current-index); } } }
                                HorizontalLayout { Text { text: "Metadata pane"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-metadata; changed current-index => { root.shortcut-changed(1, self.current-index); } } }
                                HorizontalLayout { Text { text: "Play / pause"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-play-pause; changed current-index => { root.shortcut-changed(2, self.current-index); } } }
                                HorizontalLayout { Text { text: "Previous track"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-navigate-up; changed current-index => { root.shortcut-changed(3, self.current-index); } } }
                                HorizontalLayout { Text { text: "Next track"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-navigate-down; changed current-index => { root.shortcut-changed(4, self.current-index); } } }
                                HorizontalLayout { Text { text: "Cancel edit"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-cancel-edit; changed current-index => { root.shortcut-changed(5, self.current-index); } } }
                                HorizontalLayout { Text { text: "Seek backward"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-seek-backward; changed current-index => { root.shortcut-changed(6, self.current-index); } } }
                                HorizontalLayout { Text { text: "Seek forward"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-seek-forward; changed current-index => { root.shortcut-changed(7, self.current-index); } } }
                                HorizontalLayout { Text { text: "Move to trash"; width: 130px; } ComboBox { model: shortcut-keys; current-index: root.shortcut-trash; changed current-index => { root.shortcut-changed(8, self.current-index); } } }
                            }
                            Rectangle { vertical-stretch: 1; }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                AppButton { text: "Close"; clicked => { root.close-settings(); } }
                            }
                        }
                    }
                }
            }
        }

        if root.trash-confirm-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            z: 20;
            Rectangle {
                width: 460px;
                height: 190px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;
                VerticalBox {
                    padding: 24px;
                    spacing: 14px;
                    Text { text: "Move file to trash?"; color: root.light-theme ? #202833 : #f1f4f8; font-size: 20px; }
                    Text { text: root.trash-confirm-path; color: root.light-theme ? #5c6878 : #c4ccd8; overflow: elide; }
                    CheckBox { text: "Do not ask again in this workspace"; checked: root.trash-confirm-dont-ask; toggled => { root.trash-confirm-dont-ask = self.checked; } }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        AppButton { text: "Cancel"; clicked => { root.trash-cancelled(); } }
                        AppButton { text: "Move to Trash"; clicked => { root.trash-confirmed(root.trash-confirm-dont-ask); } }
                    }
                }
            }
        }

        if root.tips-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            z: 10;

            Rectangle {
                width: 520px;
                height: 300px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;

                VerticalBox {
                    padding: 24px;
                    spacing: 14px;
                    Text {
                        text: "Did you know?";
                        color: root.light-theme ? #202833 : #f1f4f8;
                        font-size: 22px;
                    }
                    Text {
                        text: "Pressing the space bar toggles playback of the currently selected song. Pressing it twice fast in a row resumes playback from the start of the song.";
                        color: root.light-theme ? #5c6878 : #c4ccd8;
                        wrap: word-wrap;
                    }
                    CheckBox {
                        text: "Don't show tips of the day anymore";
                        checked: root.hide-tips-of-the-day;
                        toggled => { root.tips-preference-changed(self.checked); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        alignment: end;
                        AppButton { text: "Close"; clicked => { root.close-tips(); } }
                    }
                }
            }
        }

        if root.comfyui-sync-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            Rectangle {
                width: 650px;
                height: 450px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;
                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text { text: "ComfyUI Sync"; color: root.light-theme ? #202833 : #f1f4f8; font-size: 22px; }
                    Text { text: "ComfyUI URL"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                    LineEdit { text <=> root.comfyui-sync-url; placeholder-text: "https://..."; }
                    Text { text: "Remote directory"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                    LineEdit { text <=> root.comfyui-sync-remote-directory; }
                    Text { text: "Download directory inside workspace"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                    HorizontalLayout {
                        LineEdit { text <=> root.comfyui-sync-local-directory; horizontal-stretch: 1; }
                        AppButton { text: "Choose..."; clicked => { root.comfyui-sync-choose-directory(); } }
                    }
                    Text { text: "Sync frequency (milliseconds)"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                    LineEdit { text <=> root.comfyui-sync-interval; }
                    Text { text: root.comfyui-sync-error; color: #d46b32; overflow: elide; }
                    Text {
                        text: root.comfyui-sync-test-message;
                        color: root.comfyui-sync-test-success ? #27ae60 : #d46b32;
                        overflow: elide;
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        AppButton { text: "Test"; clicked => { root.comfyui-sync-test(root.comfyui-sync-url, root.comfyui-sync-remote-directory, root.comfyui-sync-local-directory, root.comfyui-sync-interval); } }
                        AppButton { text: "Cancel"; clicked => { root.comfyui-sync-cancel(); } }
                        AppButton { text: "Save and sync"; clicked => { root.comfyui-sync-save(root.comfyui-sync-url, root.comfyui-sync-remote-directory, root.comfyui-sync-local-directory, root.comfyui-sync-interval); } }
                    }
                }
            }
        }

        if root.settings-visible && root.color-picker-visible : Rectangle {
            x: (parent.width - 360px) / 2;
            y: (parent.height - 300px) / 2;
            width: 360px;
            height: 300px;
            z: 20;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            VerticalBox {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: root.color-picker-target == 0 ? "Background color" : "Text color";
                    color: root.light-theme ? #202833 : #f1f4f8;
                    font-size: 18px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Hex"; width: 50px; color: root.light-theme ? #202833 : #e3e8ef; vertical-alignment: center; }
                    LineEdit { text <=> root.color-picker-value; width: 140px; }
                    Rectangle { width: 42px; height: 28px; background: root.color-picker-target == 0 ? root.comment-background-color : root.comment-text-color; border-color: root.color-picker-target == 0 ? root.comment-text-color : root.comment-background-color; border-width: 1px; }
                }
                Text { text: "Palette"; color: root.light-theme ? #5c6878 : #c4ccd8; }
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle { width: 28px; height: 28px; background: #000000; TouchArea { clicked => { root.color-picker-value = "#000000"; } } }
                    Rectangle { width: 28px; height: 28px; background: #ffffff; border-color: #8b96a7; border-width: 1px; TouchArea { clicked => { root.color-picker-value = "#ffffff"; } } }
                    Rectangle { width: 28px; height: 28px; background: #d46b32; TouchArea { clicked => { root.color-picker-value = "#d46b32"; } } }
                    Rectangle { width: 28px; height: 28px; background: #e58a4d; TouchArea { clicked => { root.color-picker-value = "#e58a4d"; } } }
                    Rectangle { width: 28px; height: 28px; background: #2f80ed; TouchArea { clicked => { root.color-picker-value = "#2f80ed"; } } }
                    Rectangle { width: 28px; height: 28px; background: #27ae60; TouchArea { clicked => { root.color-picker-value = "#27ae60"; } } }
                    Rectangle { width: 28px; height: 28px; background: #f2c94c; TouchArea { clicked => { root.color-picker-value = "#f2c94c"; } } }
                    Rectangle { width: 28px; height: 28px; background: #eb5757; TouchArea { clicked => { root.color-picker-value = "#eb5757"; } } }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    AppButton {
                        text: "Cancel";
                        clicked => { root.color-picker-visible = false; }
                    }
                    AppButton {
                        text: "Use Color";
                        clicked => {
                            if root.color-picker-target == 0 {
                                root.comment-background-hex = root.color-picker-value;
                            } else {
                                root.comment-text-hex = root.color-picker-value;
                            }
                            root.color-picker-visible = false;
                            root.comment-colors-selected(root.comment-background-hex, root.comment-text-hex);
                        }
                    }
                }
            }
        }

        if root.comment-editor-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            Rectangle {
                width: 430px;
                height: 270px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;
                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text { text: "Comment"; color: root.light-theme ? #202833 : #f1f4f8; font-size: 22px; }
                    LineEdit { placeholder-text: "Start (seconds)"; text <=> root.comment-editor-start; }
                    LineEdit { placeholder-text: "End (seconds)"; text <=> root.comment-editor-end; }
                    LineEdit { placeholder-text: "Comment text"; text <=> root.comment-editor-text; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        AppButton { text: "Save"; clicked => { root.comment-save(root.comment-editor-path, root.comment-editor-start, root.comment-editor-end, root.comment-editor-text); } }
                        AppButton { text: "Cancel"; clicked => { root.comment-cancel(); } }
                        AppButton { text: "Delete"; enabled: root.comment-editor-path != ""; clicked => { root.comment-delete(root.comment-editor-path, root.comment-editor-start, root.comment-editor-end, root.comment-editor-text); } }
                    }
                }
            }
        }

        if root.lora-editor-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            Rectangle {
                width: 430px;
                height: 210px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;
                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text { text: "LoRA Info"; color: root.light-theme ? #202833 : #f1f4f8; font-size: 22px; }
                    Text { text: root.lora-editor-filename; color: root.light-theme ? #5c6878 : #c4ccd8; overflow: elide; }
                    LineEdit { placeholder-text: "Custom tag"; text <=> root.lora-editor-tag; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        AppButton { text: "Save"; clicked => { root.lora-save(root.lora-editor-filename, root.lora-editor-tag); } }
                        AppButton { text: "Cancel"; clicked => { root.lora-cancel(); } }
                    }
                }
            }
        }
    }
    }
}
