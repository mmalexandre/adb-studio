import { Button, LineEdit, ListView, VerticalBox } from "std-widgets.slint";

export struct TreeRow {
    path: string,
    name: string,
    depth: int,
    is-dir: bool,
    is-expanded: bool,
    is-selected: bool,
    kind: string,
}

export struct AudioRow {
    path: string,
    name: string,
    modified-date: string,
    peaks: [float],
}

component Waveform inherits Rectangle {
    height: 58px;
    background: transparent;
    in property <bool> light-theme;
    in property <[float]> peaks;

    VerticalBox {
        spacing: 0px;
        Rectangle {
            height: 29px;
            HorizontalLayout {
                spacing: 2px;
                for peak in root.peaks : Rectangle {
                    width: (parent.width - (root.peaks.length - 1) * 2px) / root.peaks.length;
                    height: 29px;
                    Rectangle {
                        width: 100%;
                        height: 2px + peak * 25px;
                        border-radius: 1px;
                        y: parent.height - self.height;
                        background: root.light-theme ? #d46b32 : #e58a4d;
                    }
                }
            }
        }
        Rectangle {
            height: 29px;
            HorizontalLayout {
                spacing: 2px;
                for peak in root.peaks : Rectangle {
                    width: (parent.width - (root.peaks.length - 1) * 2px) / root.peaks.length;
                    height: 29px;
                    Rectangle {
                        width: 100%;
                        height: 2px + peak * 25px;
                        border-radius: 1px;
                        y: 0px;
                        opacity: 0.5;
                        background: root.light-theme ? #d46b32 : #e58a4d;
                    }
                }
            }
        }
    }
}

component AudioRowView inherits Rectangle {
    height: 86px;
    background: root.light-theme ? #ffffff : #1a2029;
    border-color: root.light-theme ? #d9dee6 : #2a3340;
    border-width: 1px;
    in property <bool> light-theme;
    in property <string> name;
    in property <string> modified-date;
    in property <[float]> peaks;

    VerticalBox {
        padding: 8px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.name;
                color: root.light-theme ? #202833 : #e3e8ef;
                font-size: 14px;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            height: 58px;
            Waveform {
                width: 100%;
                light-theme: root.light-theme;
                peaks: root.peaks;
                y: -15px;
            }
        }
    }
}

component AudioList inherits ListView {
    in property <bool> light-theme;
    in property <[AudioRow]> rows;
    callback viewport-changed(int);

    changed viewport-y => {
        root.viewport-changed((0px - root.viewport-y) / 86px);
    }

    for row in root.rows : AudioRowView {
        light-theme: root.light-theme;
        name: row.name;
        modified-date: row.modified-date;
        peaks: row.peaks;
    }
}

component ExplorerRow inherits Rectangle {
    height: 26px;
    background: root.is-selected ? (root.light-theme ? #d7e3f3 : #2a3546) : transparent;
    callback clicked();
    in property <bool> light-theme;
    in property <string> name;
    in property <int> depth;
    in property <bool> is-dir;
    in property <bool> is-expanded;
    in property <bool> is-selected;
    in property <string> kind;

    function icon-source() -> image {
        if root.kind == "dir" && root.is-expanded {
            return @image-url("../assets/icons/folder-open.svg");
        }
        if root.kind == "dir" {
            return @image-url("../assets/icons/folder.svg");
        }
        if root.kind == "audio" {
            return @image-url("../assets/icons/audio.svg");
        }
        if root.kind == "safetensors" {
            return @image-url("../assets/icons/safetensors.svg");
        }
        if root.kind == "json" {
            return @image-url("../assets/icons/json.svg");
        }
        return @image-url("../assets/icons/file.svg");
    }

    HorizontalLayout {
        padding-left: 8px + root.depth * 16px;
        padding-right: 8px;
        spacing: 6px;
        Image {
            source: root.icon-source();
            width: 16px;
            height: 16px;
            vertical-alignment: center;
        }
        Text {
            text: root.name;
            color: root.light-theme ? #202833 : #e3e8ef;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component MenuButton inherits Rectangle {
    width: 70px;
    height: 40px;
    background: root.light-theme ? #eef1f5 : #1a2029;
    callback clicked();
    in property <bool> light-theme;
    in property <string> label;
    Text {
        text: root.label;
        color: root.light-theme ? #202833 : #d7dce5;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component ToolButton inherits Rectangle {
    width: 48px;
    height: 48px;
    background: root.light-theme ? #e7ebf0 : #171c24;
    callback clicked();
    in property <bool> light-theme;
    in property <string> label;
    Text {
        text: root.label;
        color: root.light-theme ? #455160 : #b7c0ce;
        font-size: 22px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Adb Studio";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 560px;
    background: #11151b;

    in-out property <bool> light-theme: false;
    in-out property <bool> has-folder: false;
    in-out property <string> folder-name: "";
    in-out property <string> build-number: "development";
    in-out property <bool> about-visible: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> file-menu-visible: false;
    in-out property <bool> edit-menu-visible: false;
    in-out property <bool> help-menu-visible: false;
    in-out property <bool> left-pane-visible: true;
    in-out property <[TreeRow]> tree-rows: [];
    in-out property <[AudioRow]> audio-rows: [];
    in-out property <string> audio-filter: "";
    in-out property <string> selected-name: "";
    in-out property <bool> audio-loading: false;
    in-out property <int> audio-completed: 0;
    in-out property <int> audio-total: 0;
    in-out property <string> audio-spinner: "|";
    callback open-folder();
    callback close-about();
    callback close-settings();
    callback theme-selected(bool);
    callback row-clicked(string);
    callback filter-changed(string);
    callback audio-viewport-changed(int);

    Rectangle {
        background: root.light-theme ? #f5f7fa : #11151b;

        VerticalBox {
            spacing: 0px;

            Rectangle {
                height: 40px;
                background: root.light-theme ? #eef1f5 : #1a2029;
                border-color: root.light-theme ? #cbd2dc : #2a3340;
                border-width: 1px;

                HorizontalLayout {
                    spacing: 0px;
                    MenuButton {
                        label: "File";
                        light-theme: root.light-theme;
                        clicked => {
                            root.file-menu-visible = !root.file-menu-visible;
                            root.edit-menu-visible = false;
                            root.help-menu-visible = false;
                        }
                    }
                    MenuButton {
                        label: "Edit";
                        light-theme: root.light-theme;
                        clicked => {
                            root.edit-menu-visible = !root.edit-menu-visible;
                            root.file-menu-visible = false;
                            root.help-menu-visible = false;
                        }
                    }
                    MenuButton {
                        label: "Help";
                        light-theme: root.light-theme;
                        clicked => {
                            root.help-menu-visible = !root.help-menu-visible;
                            root.file-menu-visible = false;
                            root.edit-menu-visible = false;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 110px;
                        Text {
                            text: "Adb Studio";
                            width: parent.width - 14px;
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            font-size: 13px;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                Rectangle {
                    width: 48px;
                    background: root.light-theme ? #e7ebf0 : #171c24;
                    border-color: root.light-theme ? #cbd2dc : #2a3340;
                    border-width: 1px;

                    VerticalBox {
                        alignment: start;
                        ToolButton {
                            label: "▤";
                            light-theme: root.light-theme;
                            clicked => { root.left-pane-visible = !root.left-pane-visible; }
                        }
                    }
                }

                if root.left-pane-visible : Rectangle {
                    width: 280px;
                    background: root.light-theme ? #eef1f5 : #1a2029;
                    border-color: root.light-theme ? #cbd2dc : #2a3340;
                    border-width: 1px;

                    if root.has-folder : VerticalBox {
                        padding: 18px;
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        Text {
                            text: "EXPLORER";
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            font-size: 11px;
                            x: 12px;
                        }
                        Text {
                            text: root.folder-name;
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 15px;
                            overflow: elide;
                            x: 12px;
                        }
                        Rectangle {
                            height: 1px;
                            background: root.light-theme ? #cbd2dc : #2a3340;
                        }
                        ListView {
                            vertical-stretch: 1;
                            for row in root.tree-rows : ExplorerRow {
                                light-theme: root.light-theme;
                                name: row.name;
                                depth: row.depth;
                                is-dir: row.is-dir;
                                is-expanded: row.is-expanded;
                                is-selected: row.is-selected;
                                kind: row.kind;
                                clicked => { root.row-clicked(row.path); }
                            }
                        }
                    }

                    if !root.has-folder : VerticalBox {
                        padding: 18px;
                        spacing: 12px;
                        Text {
                            text: "EXPLORER";
                            color: root.light-theme ? #5c6878 : #7f8b9d;
                            font-size: 11px;
                        }
                        Text {
                            text: "No folder open";
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 15px;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Rectangle {
                    background: root.light-theme ? #f5f7fa : #11151b;
                    horizontal-stretch: 1;

                    if !root.has-folder : VerticalBox {
                        alignment: center;
                        spacing: 14px;
                        Text {
                            text: "Welcome to Adb Studio";
                            color: root.light-theme ? #202833 : #e3e8ef;
                            font-size: 28px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Open a workspace folder to begin organizing your audio.";
                            color: root.light-theme ? #5c6878 : #8b96a7;
                            horizontal-alignment: center;
                        }
                        Button {
                            text: "Open Folder...";
                            clicked => { root.open-folder(); }
                        }
                    }

                    if root.has-folder : VerticalBox {
                        padding: 24px;
                        spacing: 18px;
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Audio Library";
                                color: root.light-theme ? #202833 : #e3e8ef;
                                font-size: 24px;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            LineEdit {
                                placeholder-text: "Filter audio files...";
                                width: 260px;
                                text <=> root.audio-filter;
                                edited(text) => { root.filter-changed(text); }
                            }
                        }
                        Rectangle {
                            background: root.light-theme ? #eef1f5 : #1a2029;
                            border-color: root.light-theme ? #cbd2dc : #2a3340;
                            border-width: 1px;
                            vertical-stretch: 1;
                            if root.audio-rows.length == 0 : Text {
                                text: root.audio-filter == "" ? "No audio files in this folder." : "No matching audio files.";
                                color: root.light-theme ? #5c6878 : #8b96a7;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if root.audio-rows.length > 0 : AudioList {
                                light-theme: root.light-theme;
                                rows: root.audio-rows;
                                width: 100%;
                                height: 100%;
                                viewport-changed(start-index) => { root.audio-viewport-changed(start-index); }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 32px;
                background: root.light-theme ? #eef1f5 : #1a2029;
                border-color: root.light-theme ? #cbd2dc : #2a3340;
                border-width: 1px;
                Text {
                    text: !root.has-folder ? "No workspace folder opened" : root.selected-name == "" ? "Workspace: " + root.folder-name : "Workspace: " + root.folder-name + "  —  Selected: " + root.selected-name;
                    color: root.light-theme ? #5c6878 : #7f8b9d;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    padding-right: 12px;
                    spacing: 6px;
                    Rectangle { horizontal-stretch: 1; }
                    if root.audio-loading : Text {
                        text: root.audio-spinner;
                        color: root.light-theme ? #d46b32 : #e58a4d;
                        font-size: 16px;
                    }
                    Text {
                        text: root.audio-loading ? "Waveforms " + root.audio-completed + "/" + root.audio-total : "";
                        color: root.light-theme ? #5c6878 : #7f8b9d;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.file-menu-visible : Rectangle {
            x: 0px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "Open Folder...";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.file-menu-visible = false;
                    root.open-folder();
                }
            }
        }

        if root.edit-menu-visible : Rectangle {
            x: 70px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "Settings";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.edit-menu-visible = false;
                    root.settings-visible = true;
                }
            }
        }

        if root.help-menu-visible : Rectangle {
            x: 140px;
            y: 40px;
            width: 210px;
            height: 42px;
            background: root.light-theme ? #ffffff : #202832;
            border-color: root.light-theme ? #cbd2dc : #435064;
            border-width: 1px;
            Text {
                text: "About";
                color: root.light-theme ? #202833 : #f1f4f8;
                x: 14px;
                width: parent.width - 14px;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.help-menu-visible = false;
                    root.about-visible = true;
                }
            }
        }

        if root.about-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            Rectangle {
                width: 390px;
                height: 250px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #202832;
                border-color: #435064;
                border-width: 1px;

                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text {
                        text: "About Adb Studio";
                        color: #f1f4f8;
                        font-size: 22px;
                    }
                    Text { text: "Version 0.1.0"; color: #c4ccd8; }
                    Text { text: "Build: " + root.build-number; color: #c4ccd8; }
                    Text { text: "Author: Alexandre Dupuis-Belin"; color: #c4ccd8; }
                    Rectangle { vertical-stretch: 1; }
                    Button {
                        text: "Close";
                        clicked => { root.close-about(); }
                    }
                }
            }
        }

        if root.settings-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            Rectangle {
                width: 430px;
                height: 230px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.light-theme ? #ffffff : #202832;
                border-color: root.light-theme ? #cbd2dc : #435064;
                border-width: 1px;

                VerticalBox {
                    padding: 24px;
                    spacing: 14px;
                    Text {
                        text: "Settings";
                        color: root.light-theme ? #202833 : #f1f4f8;
                        font-size: 22px;
                    }
                    Text {
                        text: "Appearance";
                        color: root.light-theme ? #5c6878 : #c4ccd8;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Button {
                            text: "Light theme";
                            clicked => { root.theme-selected(true); }
                        }
                        Button {
                            text: "Dark theme";
                            clicked => { root.theme-selected(false); }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Button {
                        text: "Close";
                        clicked => { root.close-settings(); }
                    }
                }
            }
        }
    }
}
