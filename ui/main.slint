        if root.comfyui-sync-visible : Rectangle {
            background: #00000080;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            Rectangle {
                width: 650px;
                height: 450px;
                x: (parent.width - self.width) / 2;
